---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageComparison from '../../components/ImageComparison.astro';

const entry = await getEntry('cases', 'video-editing');
if (!entry) throw new Error('Missing src/content/cases/video-editing.md');
const { meta, breadcrumb, tags, hero, subnav, glance } = entry.data;

const figmaUrl =
  'https://www.figma.com/proto/EZmyaUxAYAYzfeio6mKMoR/%D7%A2%D7%A8%D7%95%D7%9A-%D7%90%D7%AA-%D7%96%D7%94?content-scaling=fixed&node-id=684-1004&page-id=0%3A1&scaling=contain&starting-point-node-id=684%3A1004&t=ZWP2p9uJAajpSygp-1&viewport=-537%2C-541%2C0.09';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="article"
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <!-- CASE HERO HEADER (LEFT-ALIGNED) -->
  <header class="wrap" id="overview" aria-labelledby="case-title" style="padding-top: 2.5rem; text-align: left;">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">← Portfolio</a>
      <span class="separator">/</span>
      <span>{breadcrumb}</span>
    </nav>

    <div class="reveal">
      <div class="hero-meta-row" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
        <div class="card-tags">
          {
            tags.map((tag: any) => (
              <span class={tag.highlight ? 'tag-pill-sm highlight' : 'tag-pill-sm'}>{tag.label}</span>
            ))
          }
        </div>
        <a class="button button-primary" href={figmaUrl} target="_blank" rel="noopener noreferrer">
          View Live Project <span aria-hidden="true">↗</span>
        </a>
      </div>

      <h1 class="hero-name" id="case-title" style="font-size: clamp(2.8rem, 5.5vw, 4.5rem); margin-bottom: 0.75rem;">
        {hero.title}<span>.</span>
      </h1>

      <p class="hero-role-title" style="font-size: clamp(1.25rem, 2vw, 1.65rem); color: var(--ink-muted); font-weight: 600; margin-bottom: 1.5rem;">
        {hero.tagline}
      </p>

      <p class="hero-value-prop" style="margin-inline: 0; max-width: 820px; font-size: 1.25rem;" set:html={hero.valueProp} />

      <!-- OVERVIEW PLACEHOLDER -->
      <div style="margin-top: 3.5rem; margin-bottom: 2.5rem;">
        <div style="background: #1c1c1c; padding: 24px 24px 32px 24px; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.25); width: 100%; max-width: 1000px; margin: 0 auto; aspect-ratio: 16/10;">
          <iframe style="border: none; width: 100%; height: 100%; border-radius: 6px; overflow: hidden; display: block;" src="https://embed.figma.com/proto/EZmyaUxAYAYzfeio6mKMoR/%D7%A2%D7%A8%D7%95%D7%9A-%D7%90%D7%AA-%D7%96%D7%94?content-scaling=fixed&node-id=684-1004&page-id=0%3A1&scaling=contain&starting-point-node-id=684%3A1004&viewport=-537%2C-541%2C0.09&embed-host=share&hide-ui=1" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </header>

  <!-- SUBNAV -->
  <nav class="case-subnav" aria-label="Case study navigation">
    <div class="wrap">
      <ul class="case-subnav-list">
        {
          subnav.map((item: any, index: number) => (
            <li>
              <a href={item.href} class={index === 0 ? 'is-active' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- AT A GLANCE -->
  <section class="wrap at-a-glance-section" aria-labelledby="glance-heading">
    <h2 id="glance-heading" class="sr-only">Project At A Glance</h2>
    <div class="at-a-glance-grid">
      {
        glance.map((card: any, index: number) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon" aria-hidden="true">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- THE CHALLENGES -->
  <section class="wrap section" id="challenges" aria-labelledby="challenges-heading" style="padding-top: 4rem;">
    <div class="section-heading reveal">
      <h2 id="challenges-heading" style="font-size: clamp(2rem, 4vw, 3rem); font-family: var(--display); letter-spacing: -0.02em;">The Challenges<span>.</span></h2>
    </div>

    <div class="at-a-glance-grid" style="margin-bottom: 3rem;">
      <article class="at-a-glance-card reveal" data-delay="1">
        <h3>01 / INFORMATION OVERLOAD</h3>
        <p>Balancing Depth and Simplicity in Video Editing Lessons.</p>
      </article>
      <article class="at-a-glance-card reveal" data-delay="2">
        <h3>02 / APPLICATION FRICTION</h3>
        <p>Transitioning from Watching Tutorials to Actual Tools and Steps.</p>
      </article>
      <article class="at-a-glance-card reveal" data-delay="3">
        <h3>03 / THE ENGAGEMENT FATIGUE</h3>
        <p>Sustaining user engagement amidst short attention spans and a saturated digital world.</p>
      </article>
    </div>
  </section>

  <!-- THE SOLUTION -->
  <section class="wrap section" id="solution" aria-labelledby="solution-heading" style="padding-top: 4rem;">
    <div class="section-heading reveal">
      <h2 id="solution-heading" style="font-size: clamp(2rem, 4vw, 3rem); font-family: var(--display); letter-spacing: -0.02em;">The Solution: The Power of the One-Pager<span>.</span></h2>
    </div>

    <div class="at-a-glance-grid">
      <article class="at-a-glance-card reveal" data-delay="1">
        <h3>INFORMATION OVERLOAD</h3>
        <p>Using short, interactive micro-learning units and a layered UI (tabs and on-demand pop-ups) to present information in manageable chunks. This reduces cognitive overload while keeping a professional standard.</p>
      </article>
      <article class="at-a-glance-card reveal" data-delay="2">
        <h3>APPLICATION FRICTION</h3>
        <p>Reducing the gap between theory and practice by mapping a clear A-to-Z video creation workflow and providing personalized guidance based on each creator’s goals.</p>
      </article>
      <article class="at-a-glance-card reveal" data-delay="3">
        <h3>THE ENGAGEMENT FATIGUE</h3>
        <p>Driving engagement through curiosity-based interaction patterns that encourage exploration and action.</p>
      </article>
    </div>
  </section>

  <!-- FROM LOGIC TO LAYOUT -->
  <section class="wrap section" id="logic-to-layout" aria-labelledby="logic-heading" style="padding-top: 6rem;">
    <div class="section-heading reveal" style="max-width: 800px; margin-bottom: 5rem;">
      <h2 id="logic-heading" style="font-size: clamp(2.5rem, 5vw, 3.5rem); font-family: var(--display); letter-spacing: -0.02em;">From Logic to Layout<span>.</span></h2>
      <p class="hook">The journey from strategic wireframing to high-impact visual design. It’s where functional structure meets a polished user experience.</p>
    </div>

    <!-- A. HERO -->
    <div class="split-alternating" style="margin-bottom: 6rem;">
      <div class="split-text-block reveal">
        <h3 style="font-size: 1.8rem; font-family: var(--display); margin-bottom: 1.25rem;">A. THE HERO SECTION</h3>
        <p style="margin-bottom: 1.5rem; line-height: 1.6;"><strong>Goal:</strong> Visualizing the "Success State." The Hero is designed to ignite ambition, making creators see their potential and motivating them to scroll down to discover the "How-To."</p>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid var(--orange); margin-bottom: 1rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Wireframe</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Focused on the hierarchy of the "Aspirational Hook" to ensure the value proposition is the first thing that lands.</p>
        </div>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid #38a169; margin-bottom: 1.5rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Final UI</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Transformed the logic into a TikTok-inspired, high-energy environment that builds immediate trust and creative momentum.</p>
        </div>

        <p style="font-size: 1rem; line-height: 1.6; color: var(--ink-muted);"><strong>Result:</strong> Ignited user ambition by showcasing success. This immersive hook drives a deeper scroll.</p>
      </div>
      <div class="split-visual-frame reveal" data-delay="1">
        <ImageComparison 
          beforeImage="/assets/projects/plane-it-right/planeitright-ux-hero.png" 
          beforeAlt="Hero wireframe" 
          afterImage="/assets/projects/plane-it-right/planeitright-ui-hero.png" 
          afterAlt="Hero final UI" 
        />
      </div>
    </div>

    <!-- B. INSTRUCTIONAL PRINCIPLES -->
    <div class="split-alternating reverse" style="margin-bottom: 6rem;">
      <div class="split-text-block reveal">
        <h3 style="font-size: 1.8rem; font-family: var(--display); margin-bottom: 1.25rem;">B. INSTRUCTIONAL PRINCIPLES</h3>
        <p style="margin-bottom: 1.5rem; line-height: 1.6;"><strong>Goal:</strong> Showcasing the four core pillars of editing - Cutting, Lighting, Text, and Sound. The UI is built to transform complex technical skills into clear, achievable "wins" for the user.</p>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid var(--orange); margin-bottom: 1rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Wireframe</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Leveraged a tabbed navigation system to organize dense information into a clean, non-overwhelming hierarchy.</p>
        </div>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid #38a169; margin-bottom: 1.5rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Final UI</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Integrated real-world software previews to provide immediate visual proof, bridging the gap between theory and actual creative execution.</p>
        </div>

        <p style="font-size: 1rem; line-height: 1.6; color: var(--ink-muted);"><strong>Result:</strong> Simplified complex concepts through a clean tabbed UI. Live software previews enable instant mastery.</p>
      </div>
      <div class="split-visual-frame reveal" data-delay="1">
        <ImageComparison 
          beforeImage="/assets/projects/plane-it-right/planeitright-ux-page1-fix.png"
          beforeAlt="Section B UX Wireframe"
          afterImage="/assets/projects/plane-it-right/planeitright-ui-page1.png"
          afterAlt="Instructional principles final UI"
        />
      </div>
    </div>

    <!-- C. PRODUCTION WORKFLOW -->
    <div class="split-alternating" style="margin-bottom: 6rem;">
      <div class="split-text-block reveal">
        <h3 style="font-size: 1.8rem; font-family: var(--display); margin-bottom: 1.25rem;">C. THE PRODUCTION WORKFLOW</h3>
        <p style="margin-bottom: 1.5rem; line-height: 1.6;"><strong>Goal:</strong> Demystifying the end-to-end creation process. The objective was to break down the daunting 7-stage lifecycle into a digestible, linear roadmap that eliminates "Interface Anxiety" for new creators.</p>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid var(--orange); margin-bottom: 1rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Wireframe</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Focused on a minimal timeline to test if a 7-step journey felt manageable and logical before adding any visual weight.</p>
        </div>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid #38a169; margin-bottom: 1.5rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Final UI</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Transformed the timeline into an interactive "Process Line." Using on-demand pop-ups and video previews, we managed high content density without causing cognitive overload.</p>
        </div>

        <p style="font-size: 1rem; line-height: 1.6; color: var(--ink-muted);"><strong>Result:</strong> Simplified the 7-step journey using interactive pop-ups. Integrated video previews to validate every stage.</p>
      </div>
      <div class="split-visual-frame reveal" data-delay="1">
        <ImageComparison 
          beforeImage="/assets/projects/plane-it-right/planeitright-ux-page2.png" 
          beforeAlt="Production workflow wireframe" 
          afterImage="/assets/projects/plane-it-right/planeitright-ui-page2.png" 
          afterAlt="Production workflow final UI" 
        />
      </div>
    </div>

    <!-- D. PERSONALIZATION QUIZ -->
    <div class="split-alternating reverse" style="margin-bottom: 6rem;">
      <div class="split-text-block reveal">
        <h3 style="font-size: 1.8rem; font-family: var(--display); margin-bottom: 1.25rem;">D. THE PERSONALIZATION QUIZ</h3>
        <p style="margin-bottom: 1.5rem; line-height: 1.6;"><strong>Goal:</strong> Delivering a bespoke instructional experience. The objective was to replace generic advice with a tailored roadmap, providing every creator with specific tips based on their platform, style, and skill level.</p>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid var(--orange); margin-bottom: 1rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Wireframe</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Focused on the data-driven architecture to ensure a logical flow between user inputs and the generated results.</p>
        </div>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid #38a169; margin-bottom: 1.5rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Final UI</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Transformed a standard form into a vibrant, interactive dashboard. By using intuitive icons and a dynamic results panel, we turned a "task" into an engaging discovery process.</p>
        </div>

        <p style="font-size: 1rem; line-height: 1.6; color: var(--ink-muted);"><strong>Result:</strong> Delivered instant personal value. The interactive quiz bridges general advice and specific, actionable creative results.</p>
      </div>
      <div class="split-visual-frame reveal" data-delay="1">
        <ImageComparison 
          beforeImage="/assets/projects/plane-it-right/planeitright-ux-page3.png" 
          beforeAlt="Personalization quiz wireframe" 
          afterImage="/assets/projects/plane-it-right/planeitright-ui-page3.png" 
          afterAlt="Personalization quiz final UI" 
        />
      </div>
    </div>

    <!-- E. INSPIRATION GALLERY -->
    <div class="split-alternating" style="margin-bottom: 6rem;">
      <div class="split-text-block reveal">
        <h3 style="font-size: 1.8rem; font-family: var(--display); margin-bottom: 1.25rem;">E. THE INSPIRATION GALLERY</h3>
        <p style="margin-bottom: 1.5rem; line-height: 1.6;"><strong>Goal:</strong> Providing "Aspirational Proof." The objective is to leverage familiar social patterns, like the Instagram Story UI - to showcase top-tier creator content and break down the specific techniques that made them successful.</p>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid var(--orange); margin-bottom: 1rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Wireframe</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Prioritized a circular layout to mimic a mobile-first social experience, ensuring the interaction felt intuitive and familiar before any visual assets were added.</p>
        </div>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid #38a169; margin-bottom: 1.5rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Final UI</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Transformed a simple gallery into a research-driven tool. Each "Story" opens a deep dive into a successful video, offering the user actionable editing blueprints based on real-world viral results.</p>
        </div>

        <p style="font-size: 1rem; line-height: 1.6; color: var(--ink-muted);"><strong>Result:</strong> Bridged theory and practice. This gallery turns inspiration into a strategic blueprint for viral content creation.</p>
      </div>
      <div class="split-visual-frame reveal" data-delay="1">
        <ImageComparison 
          beforeImage="/assets/projects/plane-it-right/planeitright-ux-page4.png" 
          beforeAlt="Inspiration gallery wireframe" 
          afterImage="/assets/projects/plane-it-right/planeitright-ui-page4.png" 
          afterAlt="Inspiration gallery final UI" 
        />
      </div>
    </div>

    <!-- F. FAQ SECTION -->
    <div class="split-alternating reverse">
      <div class="split-text-block reveal">
        <h3 style="font-size: 1.8rem; font-family: var(--display); margin-bottom: 1.25rem;">F. FAQ SECTION</h3>
        <p style="margin-bottom: 1.5rem; line-height: 1.6;"><strong>Goal:</strong> Providing quick, accessible answers to common beginner pain points. This section ensures no question goes unanswered, building user trust and maintaining learning momentum.</p>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid var(--orange); margin-bottom: 1rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Wireframe</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Established a clean, functional accordion system to prioritize scannability and test the logic of information density.</p>
        </div>
        
        <div style="background: var(--paper-soft); padding: 1.5rem; border-radius: 8px; border-left: 3px solid #38a169; margin-bottom: 1.5rem;">
          <strong style="display: block; font-size: 0.95rem; margin-bottom: 0.35rem; color: var(--ink);">Final UI</strong>
          <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted);">Transformed the standard list into a seamless part of the "Maker" aesthetic. The polished interactions and gradient backgrounds turn a purely functional area into an engaging experience.</p>
        </div>

        <p style="font-size: 1rem; line-height: 1.6; color: var(--ink-muted);"><strong>Result:</strong> Ensured a frictionless journey by resolving lingering doubts. This interactive repository minimizes clutter and builds trust.</p>
      </div>
      <div class="split-visual-frame reveal" data-delay="1">
        <ImageComparison 
          beforeImage="/assets/projects/plane-it-right/planeitright-ux-page5.png" 
          beforeAlt="FAQ section wireframe" 
          afterImage="/assets/projects/plane-it-right/planeitright-ui-page5.png" 
          afterAlt="FAQ section final UI" 
        />
      </div>
    </div>
  </section>

  <style>
    /* Widen the max-width and increase slider proportions for better visibility */
    #logic-to-layout {
      --wrap: min(1380px, calc(100% - 64px));
    }
    #logic-to-layout .split-visual-frame {
      padding: 0.5rem;
    }
    @media (min-width: 1025px) {
      #logic-to-layout .split-alternating {
        grid-template-columns: 0.7fr 1.3fr;
        gap: clamp(2.5rem, 4vw, 3.5rem);
      }
      #logic-to-layout .split-alternating.reverse {
        grid-template-columns: 1.3fr 0.7fr;
      }
    }
  </style>
</BaseLayout>
