---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('cases', 'video-editing');
if (!entry) throw new Error('Missing src/content/cases/video-editing.md');
const { meta, breadcrumb, tags, hero, subnav, glance, impact, nextCase } = entry.data;

const figmaUrl =
  'https://embed.figma.com/proto/EZmyaUxAYAYzfeio6mKMoR/%D7%A2%D7%A8%D7%95%D7%9A-%D7%90%D7%AA-%D7%96%D7%94?node-id=684-1004&p=f&viewport=-565%2C-481%2C0.09&scaling=scale-down&content-scaling=fixed&starting-point-node-id=684%3A1004&page-id=0%3A1&embed-host=share';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="article"
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <!-- CASE HERO HEADER (LEFT-ALIGNED) -->
  <header class="wrap" id="overview" aria-labelledby="case-title" style="padding-top: 2.5rem; text-align: left;">
    <!-- Top Left Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">← Portfolio</a>
      <span class="separator">/</span>
      <span>{breadcrumb}</span>
    </nav>

    <div class="reveal">
      <div class="card-tags" style="margin-bottom: 1rem;">
        {
          tags.map((tag) => (
            <span class={tag.highlight ? 'tag-pill-sm highlight' : 'tag-pill-sm'}>{tag.label}</span>
          ))
        }
      </div>

      <h1 class="hero-name" id="case-title" style="font-size: clamp(2.8rem, 5.5vw, 4.5rem); margin-bottom: 0.75rem;">
        {hero.title}<span>.</span>
      </h1>

      <p class="hero-role-title" style="font-size: clamp(1.25rem, 2vw, 1.65rem); color: var(--ink-muted); font-weight: 600; margin-bottom: 1.5rem;">
        {hero.tagline}
      </p>

      <p class="hero-value-prop" style="margin-inline: 0; max-width: 820px; font-size: 1.25rem;" set:html={hero.valueProp} />

      <!-- LARGE DEDICATED SHOWCASE MEDIA PLACEHOLDER -->
      <div class="showcase-media-frame">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 1rem; margin-bottom: 1.5rem;">
          <span style="font-family: var(--display); font-size: 0.85rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--orange);">
            🎬 Interactive Figma Prototype
          </span>
          <a class="pill-badge dark" href={figmaUrl} target="_blank" rel="noreferrer" style="text-decoration: none;">
            Open Full Screen Figma ↗
          </a>
        </div>

        <!-- Video / High-Resolution Image Frame Placeholder -->
        <div style="background: rgba(0,0,0,0.4); border-radius: var(--radius-md); border: 2px dashed rgba(255,255,255,0.15); min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; position: relative;">
          <div style="font-size: 3.5rem; margin-bottom: 1rem;">💻</div>
          <h3 style="color: #ffffff; font-size: 1.4rem; margin: 0 0 0.5rem;">Interactive Learning One-Pager UI &amp; Prototype</h3>
          <p style="color: rgba(255,255,255,0.7); max-width: 520px; font-size: 0.95rem; margin: 0 0 1.5rem;">
            [ Embedded Interactive Figma Prototype &amp; Step-by-Step Production UI Mockup ]
          </p>
          <a class="button button-primary" href={figmaUrl} target="_blank" rel="noreferrer">
            Interact with Prototype <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- IN-PAGE STICKY SUBNAV WITH ACTIVE HIGHLIGHT -->
  <nav class="case-subnav" aria-label="Case study navigation">
    <div class="wrap">
      <ul class="case-subnav-list">
        {
          subnav.map((item, index) => (
            <li>
              <a href={item.href} class={index === 0 ? 'is-active' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- 01 / "AT A GLANCE" SECTION (3 DISTINCT CARDS) -->
  <section class="wrap at-a-glance-section" aria-labelledby="glance-heading">
    <h2 id="glance-heading" class="sr-only">Project At A Glance</h2>
    <div class="at-a-glance-grid">
      {
        glance.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon" aria-hidden="true">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- 02 / CONTENT BLOCKS -->

  <!-- BLOCK 1: OVERVIEW & THE BRIEF -->
  <section class="wrap section" id="overview-brief" aria-labelledby="overview-brief-heading" style="padding-top: 2rem;">
    <div class="split-alternating">
      <div class="split-text-block reveal">
        <p class="eyebrow">01 / The Brief</p>
        <h2 id="overview-brief-heading">Performance Over Tool Menus<span>.</span></h2>
        <p>
          The challenge was not to explain video-editing tools, but to help beginners understand what to do, in what order, and why each editorial decision matters.
        </p>
        <p>
          I began by defining the target performance: enabling a learner to plan, execute, and export a publishable first video with confidence. I identified the minimum essential knowledge, eliminated advanced feature bloat, and mapped the remainder into a clean visual journey.
        </p>
        <div class="takeaway-box">
          <p><strong>Instructional Principle:</strong> Remove software feature-overload. Focus entirely on the immediate goal of producing a publishable first video.</p>
        </div>
      </div>

      <div class="split-visual-frame reveal" data-delay="1">
        <span style="font-size: 0.75rem; font-weight: 800; color: var(--orange); text-transform: uppercase; letter-spacing: 0.06em;">Instructional Reframing</span>
        <h4 style="font-size: 1.2rem; margin: 0.5rem 0 1rem;">Software Manual vs. Performance Path</h4>

        <div style="display: grid; gap: 0.85rem;">
          <div style="background: var(--paper-soft); padding: 1rem; border-radius: 8px; border-left: 3px solid #e05252;">
            <strong style="display: block; font-size: 0.9rem; color: #e05252; margin-bottom: 0.2rem;">❌ Software Menu Approach</strong>
            <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Explaining 50+ toolbars and settings before the learner even touches footage.</p>
          </div>

          <div style="background: var(--paper-soft); padding: 1rem; border-radius: 8px; border-left: 3px solid #38a169;">
            <strong style="display: block; font-size: 0.9rem; color: #38a169; margin-bottom: 0.2rem;">✓ Goal-Oriented Creator Flow</strong>
            <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Step-by-step task execution answering: "What do I cut first and why?"</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK 2: AUDIENCE ANALYSIS -->
  <section class="wrap section" id="audience" aria-labelledby="audience-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">02 / Audience Insights</p>
      <h2 id="audience-heading">Designing for Beginner Creators<span>.</span></h2>
      <p class="hook">The audience is digitally native, but not yet fluent in editing. They are motivated by publishing a stronger video—not by learning software.</p>
    </div>

    <div class="at-a-glance-grid">
      <article class="at-a-glance-card reveal" data-delay="1">
        <span class="glance-icon">🎯</span>
        <h3>Outcome-Driven</h3>
        <p>They want the fastest direct route to a visible, polished result they can proudly share on social media.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="2">
        <span class="glance-icon">🛡️</span>
        <h3>Overcoming Low Confidence</h3>
        <p>Complex interfaces and technical jargon cause analysis paralysis; clear scaffolding restores momentum.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="3">
        <span class="glance-icon">⏱️</span>
        <h3>Short Learning Moments</h3>
        <p>They learn by doing in short bursts. Content must support quick on-demand references while editing.</p>
      </article>

      <!-- data-delay="4" has no matching rule in styles.css, so this card gets no
           stagger. Carried over from the old site as-is. -->
      <article class="at-a-glance-card reveal" data-delay="4">
        <span class="glance-icon">📱</span>
        <h3>Platform-Agnostic Principles</h3>
        <p>Principles (pacing, cuts, lighting) transfer seamlessly across TikTok, YouTube, and Reels.</p>
      </article>
    </div>
  </section>

  <!-- BLOCK 3: THE CONTENT CHALLENGE -->
  <section class="wrap section" id="challenge" aria-labelledby="challenge-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">03 / Content Deconstruction</p>
      <h2 id="challenge-heading">The Content Challenge<span>.</span></h2>
      <p class="hook">Translating an expansive professional domain into an actionable learning sequence.</p>
    </div>

    <div class="at-a-glance-grid">
      <article class="at-a-glance-card reveal" data-delay="1">
        <span class="glance-icon">🗂️</span>
        <h3>1. Prioritize the Essential</h3>
        <p>Distinguished essential core principles needed for a first cut from advanced features that create cognitive overload.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="2">
        <span class="glance-icon">🛤️</span>
        <h3>2. Meaningful Sequence</h3>
        <p>Replaced scattered online tips with a structured task flow matching the creator’s real process—from planning to export.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="3">
        <span class="glance-icon">🎬</span>
        <h3>3. Knowledge to Action</h3>
        <p>Every concept directly answers: “What do I do next?”pairing visual creator worked examples with concrete steps.</p>
      </article>
    </div>
  </section>

  <!-- BLOCK 4: ONE-PAGE LEARNING STRATEGY -->
  <section class="wrap section" id="strategy" aria-labelledby="strategy-heading">
    <div class="split-alternating reverse">
      <div class="split-text-block reveal">
        <p class="eyebrow">04 / Learning Strategy</p>
        <h2 id="strategy-heading">Why a One-Page Website?<span>.</span></h2>
        <p>
          A responsive one-page website minimizes navigation friction, preserves the chronological learning sequence, and allows creators to keep the guide open on a secondary screen while editing.
        </p>
        <ul>
          <li><strong>Performance-Centered Architecture:</strong> Organizes around creating the video, not software toolbars.</li>
          <li><strong>Chunking Without Context Loss:</strong> Interactive tabs and modals deliver depth on demand without scattering navigation.</li>
          <li><strong>Worked Examples:</strong> Deconstructs real creator videos to make abstract pacing principles immediately observable.</li>
        </ul>

        <div class="takeaway-box">
          <p><strong>Design Win:</strong> Frictionless dual-screen reference preserving the learner's creative momentum.</p>
        </div>
      </div>

      <div class="split-visual-frame reveal" data-delay="1" style="background: var(--ink); color: #ffffff;">
        <span style="font-size: 0.72rem; font-weight: 800; color: #ffaa40; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">Connected Learning Ecosystem</span>
        <h4 style="color: #ffffff; font-size: 1.2rem; margin: 0 0 1rem;">5 Core Page Stages</h4>

        <div style="display: grid; gap: 0.65rem;">
          <div style="background: rgba(255,255,255,0.06); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.88rem;">
            <strong style="color: #ffaa40;">01. Foundations:</strong> The 4 core principles (Cut, Light, Text, Sound).
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.88rem;">
            <strong style="color: #ffaa40;">02. Production Flow:</strong> 7-step roadmap from raw clips to final export.
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.88rem;">
            <strong style="color: #ffaa40;">03. Personalization:</strong> Interactive diagnostic quiz matching style.
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.88rem;">
            <strong style="color: #ffaa40;">04. Worked Examples:</strong> Story-based creator inspiration gallery.
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.88rem;">
            <strong style="color: #ffaa40;">05. FAQ Support:</strong> On-demand troubleshooting accordions.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK 5: FROM LOGIC TO LAYOUT (6 INTERFACE DECISIONS) -->
  <section class="wrap section" id="decisions" aria-labelledby="decisions-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">05 / Instructional UX/UI</p>
      <h2 id="decisions-heading">From Logic to Layout<span>.</span></h2>
      <p class="hook">Each interface pattern was born from an instructional requirement: what does the learner need to decide or do next?</p>
    </div>

    <div class="at-a-glance-grid">
      <article class="at-a-glance-card reveal" data-delay="1">
        <span class="glance-icon">🚀</span>
        <h3>01. Hero Promise ("Make The Cut")</h3>
        <p><strong>Need:</strong> Establish value before software intimidation.<br><strong>Decision:</strong> Frame around creating a publishable video with a clear guided path.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="2">
        <span class="glance-icon">📑</span>
        <h3>02. Tabbed Principles (Cut / Light / Text / Sound)</h3>
        <p><strong>Need:</strong> Foundational mental models.<br><strong>Decision:</strong> Chunk 4 universal pillars into interactive tabs, reducing simultaneous cognitive load.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="3">
        <span class="glance-icon">🛤️</span>
        <h3>03. The 7-Stage Process Line</h3>
        <p><strong>Need:</strong> Build end-to-end task awareness.<br><strong>Decision:</strong> Persistent timeline showing current stage, with modals for on-demand details.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="1">
        <span class="glance-icon">🎨</span>
        <h3>04. Personalization Quiz ("What's Your Vibe?")</h3>
        <p><strong>Need:</strong> Tailor principles to learner platform.<br><strong>Decision:</strong> 3-question diagnostic providing custom tool recommendations.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="2">
        <span class="glance-icon">👁️</span>
        <h3>05. Inspiration Worked Gallery</h3>
        <p><strong>Need:</strong> Bridge theory to actual video formats.<br><strong>Decision:</strong> Social-story format deconstructing techniques behind real viral edits.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="3">
        <span class="glance-icon">❓</span>
        <h3>06. Performance Support FAQ</h3>
        <p><strong>Need:</strong> Fast troubleshooting without clutter.<br><strong>Decision:</strong> Clean accordion keeping primary learning path lean.</p>
      </article>
    </div>
  </section>

  <!-- BLOCK 6: OUTCOMES & REFLECTION -->
  <section class="wrap section" id="impact" aria-labelledby="impact-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">{impact.eyebrow}</p>
      <h2 id="impact-heading"><Fragment set:html={impact.heading} /><span>.</span></h2>
      <p class="hook" set:html={impact.hook} />
    </div>

    <div class="at-a-glance-grid">
      {
        impact.cards.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>

    <!-- Navigation to Next Case -->
    {nextCase && (
      <div style="text-align: left; margin-top: 3.5rem;" class="reveal">
        <a class="button button-dark" href={nextCase.href}>
          {nextCase.label} <span aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </section>
</BaseLayout>
