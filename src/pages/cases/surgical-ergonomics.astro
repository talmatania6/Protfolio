---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('cases', 'surgical-ergonomics');
if (!entry) throw new Error('Missing src/content/cases/surgical-ergonomics.md');
const { meta, breadcrumb, tags, hero, subnav, glance, impact, nextCase } = entry.data;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="article"
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <!-- CASE HERO HEADER (LEFT-ALIGNED) -->
  <header class="wrap" id="overview" aria-labelledby="case-title" style="padding-top: 2.5rem; text-align: left;">
    <!-- Top Left Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">← Portfolio</a>
      <span class="separator">/</span>
      <span>{breadcrumb}</span>
    </nav>

    <div class="reveal">
      <div class="card-tags" style="margin-bottom: 1rem;">
        {
          tags.map((tag) => (
            <span class={tag.highlight ? 'tag-pill-sm highlight' : 'tag-pill-sm'}>{tag.label}</span>
          ))
        }
      </div>

      <h1 class="hero-name" id="case-title" style="font-size: clamp(2.8rem, 5.5vw, 4.5rem); margin-bottom: 0.75rem;">
        {hero.title}<span>.</span>
      </h1>

      <p class="hero-role-title" style="font-size: clamp(1.25rem, 2vw, 1.65rem); color: var(--ink-muted); font-weight: 600; margin-bottom: 1.5rem;">
        {hero.tagline}
      </p>

      <p class="hero-value-prop" style="margin-inline: 0; max-width: 820px; font-size: 1.25rem;" set:html={hero.valueProp} />

      <!-- LARGE DEDICATED SHOWCASE MEDIA PLACEHOLDER -->
      <div class="showcase-media-frame">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 1rem; margin-bottom: 1.5rem;">
          <span style="font-family: var(--display); font-size: 0.85rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--orange);">
            📱 Clinical App Showcase &amp; Video Modules
          </span>
          <span class="pill-badge dark">Mobile-First Microlearning</span>
        </div>

        <!-- Video / High-Resolution Image Frame Placeholder -->
        <div style="background: rgba(0,0,0,0.4); border-radius: var(--radius-md); border: 2px dashed rgba(255,255,255,0.15); min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; position: relative;">
          <div style="font-size: 3.5rem; margin-bottom: 1rem;">🩺</div>
          <h3 style="color: #ffffff; font-size: 1.4rem; margin: 0 0 0.5rem;">Surgical Ergonomics Mobile Interface &amp; OR Media</h3>
          <p style="color: rgba(255,255,255,0.7); max-width: 520px; font-size: 0.95rem; margin: 0;">
            [ Dedicated Showcase Frame for App Screenshots, OR Demonstrations, and HeyGen AI Avatar Clips ]
          </p>
          <div style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; justify-content: center;">
            <span class="pill-badge dark">7 Clinical Modules</span>
            <span class="pill-badge dark">AI Digital Instructor</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- IN-PAGE STICKY SUBNAV WITH ACTIVE HIGHLIGHT -->
  <nav class="case-subnav" aria-label="Case study navigation">
    <div class="wrap">
      <ul class="case-subnav-list">
        {
          subnav.map((item, index) => (
            <li>
              <a href={item.href} class={index === 0 ? 'is-active' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- 01 / "AT A GLANCE" SECTION (3 DISTINCT CARDS) -->
  <section class="wrap at-a-glance-section" aria-labelledby="glance-heading">
    <h2 id="glance-heading" class="sr-only">Project At A Glance</h2>
    <div class="at-a-glance-grid">
      {
        glance.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon" aria-hidden="true">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- 02 / CONTENT BLOCKS -->

  <!-- BLOCK 1: WHY THIS MATTERS (DATA & CONTEXT) -->
  <section class="wrap section" id="context" aria-labelledby="context-heading" style="padding-top: 2rem;">
    <div class="section-heading reveal">
      <p class="eyebrow">01 / The Context</p>
      <h2 id="context-heading">Why This Project Matters<span>.</span></h2>
      <p class="hook">Surgeons face a severe occupational hazard that directly impacts their longevity and clinical practice.</p>
    </div>

    <!-- Stats Grid -->
    <div class="at-a-glance-grid reveal" data-delay="1">
      <article class="at-a-glance-card">
        <span style="font-family: var(--display); font-size: clamp(2.4rem, 4.5vw, 3.5rem); font-weight: 900; color: var(--orange); line-height: 1; display: block; margin-bottom: 0.5rem;">76%</span>
        <p><strong>European surgeons</strong> report work-related musculoskeletal disorders during their career.</p>
      </article>

      <article class="at-a-glance-card">
        <span style="font-family: var(--display); font-size: clamp(2.4rem, 4.5vw, 3.5rem); font-weight: 900; color: var(--orange); line-height: 1; display: block; margin-bottom: 0.5rem;">52%</span>
        <p><strong>Experience lower back pain</strong> from continuous, awkward static standing postures.</p>
      </article>

      <article class="at-a-glance-card">
        <span style="font-family: var(--display); font-size: clamp(2.4rem, 4.5vw, 3.5rem); font-weight: 900; color: var(--orange); line-height: 1; display: block; margin-bottom: 0.5rem;">51%</span>
        <p><strong>Experience chronic neck pain</strong> caused by unadjusted surgical monitors and tables.</p>
      </article>
    </div>

    <div class="split-alternating" style="margin-top: 2.5rem;">
      <div class="split-text-block reveal">
        <p>
          Prolonged static posture, awkward positioning, and repetitive movements make musculoskeletal disorders one of the most common occupational challenges faced by surgeons today.
        </p>
        <p>
          Additionally, <strong>43%</strong> of surgeons experience severe shoulder pain, and <strong>12%</strong> report that physical pain has directly hindered or cut short their surgical operating career.
        </p>
        <div class="takeaway-box">
          <p><strong>Key Insight:</strong> The issue was not a lack of theoretical recommendations—it was a performance transfer problem in high-stress operating environments.</p>
        </div>
      </div>

      <div class="split-visual-frame reveal" data-delay="1">
        <span style="font-size: 0.75rem; font-weight: 800; color: var(--orange); text-transform: uppercase; letter-spacing: 0.06em;">Empirical Research Base</span>
        <h4 style="font-size: 1.2rem; margin: 0.5rem 0 1rem;">Primary Research Sources</h4>
        <ul style="padding-left: 1.25rem; margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--ink);">
          <li style="margin-bottom: 0.75rem;"><strong>PMC Systematic Review (2025):</strong> Meta-analysis on work-related musculoskeletal disorders among European surgeons.</li>
          <li style="margin-bottom: 0.75rem;"><strong>JAMA Surgery:</strong> Systematic review analyzing physical symptoms and ergonomic interventions.</li>
          <li><strong>Surgical Ergonomics Review (2024):</strong> Behavioral patterns in modern laparoscopic and robotic ORs.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- BLOCK 2: THE CHALLENGE & LEARNING OPPORTUNITY -->
  <section class="wrap section" id="challenge" aria-labelledby="challenge-heading">
    <div class="split-alternating reverse">
      <div class="split-text-block reveal">
        <p class="eyebrow">02 / The Reality</p>
        <h2 id="challenge-heading">The Performance Challenge<span>.</span></h2>
        <p>
          Many surgeons spend hours maintaining highly demanding static postures during surgical procedures. Despite existing ergonomic guidelines, incorrect body positioning quickly becomes habitual under operating pressure.
        </p>
        <p>
          The challenge was not the absence of information. It was translating ergonomic recommendations into practical, instinctual behaviors inside the operating room. This is a <strong>performance problem</strong>, not simply an educational one.
        </p>

        <div class="takeaway-box">
          <p><strong>Core Learning Opportunity:</strong> Shift from passive theory to behavioral change through 3 core cognitive pillars: <em>Recognize</em>, <em>Compare</em>, and <em>Apply</em>.</p>
        </div>
      </div>

      <div class="split-visual-frame reveal" data-delay="1">
        <span style="font-size: 0.75rem; font-weight: 800; color: var(--orange); text-transform: uppercase; letter-spacing: 0.06em;">Instructional Triad</span>
        <h4 style="font-size: 1.25rem; margin: 0.5rem 0 1rem;">Behavioral Transformation Pillars</h4>

        <div style="display: grid; gap: 0.85rem;">
          <div style="display: flex; gap: 0.75rem; align-items: flex-start; background: var(--paper-soft); padding: 0.85rem; border-radius: 8px;">
            <span style="font-size: 1.25rem;">👁️</span>
            <div>
              <strong style="font-size: 0.95rem; display: block;">1. Recognize</strong>
              <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Help surgeons self-diagnose incorrect posture and bad habits in real time.</p>
            </div>
          </div>

          <div style="display: flex; gap: 0.75rem; align-items: flex-start; background: var(--paper-soft); padding: 0.85rem; border-radius: 8px;">
            <span style="font-size: 1.25rem;">⚖️</span>
            <div>
              <strong style="font-size: 0.95rem; display: block;">2. Compare</strong>
              <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Contrast habitual positioning with recommended techniques through side-by-side OR visuals.</p>
            </div>
          </div>

          <div style="display: flex; gap: 0.75rem; align-items: flex-start; background: var(--paper-soft); padding: 0.85rem; border-radius: 8px;">
            <span style="font-size: 1.25rem;">🔄</span>
            <div>
              <strong style="font-size: 0.95rem; display: block;">3. Apply</strong>
              <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Empower clinicians to apply healthy posture adjustments right before scrubbing in.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK 3: WHY MICROLEARNING & THE SOLUTION -->
  <section class="wrap section" id="solution" aria-labelledby="solution-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">03 / The Intervention</p>
      <h2 id="solution-heading">Why Microlearning &amp; The 7 Modules<span>.</span></h2>
      <p class="hook">Surgeons have extremely limited availability. Traditional hour-long lectures fail; bite-sized microlearning succeeds.</p>
    </div>

    <div class="split-alternating" style="margin-bottom: 3rem;">
      <div class="split-text-block reveal">
        <p>
          Lengthy training sessions are impossible for busy surgical teams to attend and even harder to revisit when a quick refresher is needed.
        </p>
        <p>
          By designing a <strong>mobile-first microlearning companion</strong>, surgeons can consume focused, 90-second instructional demonstrations immediately before a case or between procedures, fitting seamlessly into the clinical workflow.
        </p>
      </div>

      <div class="split-visual-frame reveal" data-delay="1">
        <div style="display: grid; gap: 0.85rem;">
          <div style="background: var(--paper-soft); padding: 1rem; border-radius: 8px; border-left: 3px solid #e05252;">
            <strong style="display: block; font-size: 0.9rem; color: #e05252; margin-bottom: 0.2rem;">❌ Traditional Clinical Training</strong>
            <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Long, inflexible classroom lectures that take surgeons away from patient care.</p>
          </div>

          <div style="background: var(--paper-soft); padding: 1rem; border-radius: 8px; border-left: 3px solid #38a169;">
            <strong style="display: block; font-size: 0.9rem; color: #38a169; margin-bottom: 0.2rem;">✓ Just-in-Time Microlearning</strong>
            <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Short, highly targeted video modules consumed on mobile before scrubbing in.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- The 7 Modules Grid -->
    <h3 style="font-size: 1.5rem; margin-bottom: 1.5rem;" class="reveal">The 7 Focused Instructional Modules:</h3>
    <div class="at-a-glance-grid">
      <article class="at-a-glance-card reveal" data-delay="1">
        <span class="glance-icon">📏</span>
        <h3>1. Surgeon Height Discrepancies</h3>
        <p>Strategies for sharing an operating table when surgical team members vary significantly in physical height.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="2">
        <span class="glance-icon">🛏️</span>
        <h3>2. Adjusting the OR Table</h3>
        <p>Optimizing the table height, tilt, and angle to eliminate chronic stooping, hyper-extension, or overreaching.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="3">
        <span class="glance-icon">🖥️</span>
        <h3>3. Surgical Monitor Angles</h3>
        <p>Positioning laparoscopic and endoscopic monitors directly in the line of sight to prevent cervical spine compression.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="1">
        <span class="glance-icon">🧍</span>
        <h3>4. Correct Postural Alignment</h3>
        <p>Establishing the foundational neutral spine and shoulder positions for prolonged static standing procedures.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="2">
        <span class="glance-icon">🔬</span>
        <h3>5. Endoscopic Procedures</h3>
        <p>Ergonomic techniques for managing specialized tools, grip fatigue, and arm positioning during keyhole surgery.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="3">
        <span class="glance-icon">👁️‍🗨️</span>
        <h3>6. Microscopic Procedures</h3>
        <p>Maintaining high-magnification visual focus without sacrificing head alignment or neck stability.</p>
      </article>
    </div>

    <div class="at-a-glance-card reveal" data-delay="1" style="margin-top: 1.5rem; max-width: 600px;">
      <span class="glance-icon">👣</span>
      <h3>7. The Pedal Dance</h3>
      <p>Managing multiple electrocautery and suction foot pedals safely while maintaining balance and reducing lower limb fatigue.</p>
    </div>
  </section>

  <!-- BLOCK 4: MEDIA PRODUCTION & AI GUIDE -->
  <section class="wrap section" id="production" aria-labelledby="production-heading">
    <div class="split-alternating">
      <div class="split-text-block reveal">
        <p class="eyebrow">04 / Video Craft &amp; Technology</p>
        <h2 id="production-heading">Media Production &amp; The AI Guide<span>.</span></h2>
        <p>
          Filming took place directly inside a live operating room alongside an ergonomics specialist and an experienced surgeon. Demonstrations intentionally captured both the <strong>incorrect posture</strong> and the <strong>recommended posture</strong> in realistic clinical settings.
        </p>
        <p>
          To unify the 7 micro-modules, I integrated an <strong>AI-generated digital instructor</strong>. Rather than using generic voiceover, an AI surgeon character was generated, styled, and animated in HeyGen to deliver consistent, authoritative guidance before each live-action demonstration.
        </p>
        <ul>
          <li><strong>Authentic Visual Contrast:</strong> Comparing flawed habits with correct postures side-by-side enhances schema recognition.</li>
          <li><strong>Cognitive Editing in Camtasia:</strong> Trimmed dead time, added visual callout overlays, and paced cuts to respect the surgeon's attention span.</li>
          <li><strong>Cohesive AI Persona:</strong> Builds trust across all sessions with continuous expert presence.</li>
        </ul>

        <div class="takeaway-box">
          <p><strong>Instructional Win:</strong> High production credibility matched with crisp, cognitive-load-conscious editing.</p>
        </div>
      </div>

      <div class="split-visual-frame reveal" data-delay="1" style="background: var(--ink); color: #ffffff;">
        <span style="font-size: 0.72rem; font-weight: 800; color: #ffaa40; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">Production Pipeline</span>
        <h4 style="color: #ffffff; font-size: 1.2rem; margin: 0 0 1rem;">OR Observation → AI Animated Guide</h4>

        <div style="display: grid; gap: 0.75rem;">
          <div style="background: rgba(255,255,255,0.06); padding: 0.85rem; border-radius: 8px;">
            <strong style="color: #ffaa40; font-size: 0.88rem; display: block;">01. Live OR Filming</strong>
            <p style="margin: 0; font-size: 0.82rem; color: rgba(255,255,255,0.7);">Capturing real table heights, monitor placements, and bad habit comparisons.</p>
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 0.85rem; border-radius: 8px;">
            <strong style="color: #ffaa40; font-size: 0.88rem; display: block;">02. HeyGen AI Animation</strong>
            <p style="margin: 0; font-size: 0.82rem; color: rgba(255,255,255,0.7);">Generating lifelike narration from a consistent digital surgeon mentor.</p>
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 0.85rem; border-radius: 8px;">
            <strong style="color: #ffaa40; font-size: 0.88rem; display: block;">03. Instructional Editing</strong>
            <p style="margin: 0; font-size: 0.82rem; color: rgba(255,255,255,0.7);">Camtasia editing optimized for cognitive load reduction and rapid recall.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK 5: KEY DESIGN DECISIONS -->
  <section class="wrap section" id="decisions" aria-labelledby="decisions-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">05 / Strategic Choices</p>
      <h2 id="decisions-heading">Key Design Decisions<span>.</span></h2>
      <p class="hook">Every structural choice was engineered to maximize behavioral retention and respect surgeon time.</p>
    </div>

    <div class="at-a-glance-grid">
      <article class="at-a-glance-card reveal" data-delay="1">
        <span class="glance-icon">⏱️</span>
        <h3>Format: Microlearning</h3>
        <p><strong>Decision:</strong> 7 hyper-focused 90-second modules.<br><strong>Why:</strong> Surgeons cannot attend long courses.<br><strong>Impact:</strong> 100% completion rates with just-in-time usability.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="2">
        <span class="glance-icon">⚖️</span>
        <h3>Cognitive Strategy: Comparison</h3>
        <p><strong>Decision:</strong> Side-by-side incorrect vs. correct video demonstrations.<br><strong>Why:</strong> Self-recognition is the first step to behavioral change.<br><strong>Impact:</strong> Bridged theory into self-awareness.</p>
      </article>

      <article class="at-a-glance-card reveal" data-delay="3">
        <span class="glance-icon">🏥</span>
        <h3>Media: Authentic OR Footage</h3>
        <p><strong>Decision:</strong> Filmed inside active operating rooms with real gear.<br><strong>Why:</strong> Studio settings lack authentic clinical constraints.<br><strong>Impact:</strong> Unconditional credibility with expert clinicians.</p>
      </article>
    </div>
  </section>

  <!-- BLOCK 6: REFLECTION & OUTCOMES -->
  <section class="wrap section" id="impact" aria-labelledby="impact-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">{impact.eyebrow}</p>
      <h2 id="impact-heading"><Fragment set:html={impact.heading} /><span>.</span></h2>
      <p class="hook" set:html={impact.hook} />
    </div>

    <div class="at-a-glance-grid">
      {
        impact.cards.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>

    <!-- Navigation to Next Case -->
    <div style="text-align: left; margin-top: 3.5rem;" class="reveal">
      <a class="button button-dark" href={nextCase.href}>
        {nextCase.label} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
