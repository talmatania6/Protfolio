---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('cases', 'surgical-ergonomics');
if (!entry) throw new Error('Missing src/content/cases/surgical-ergonomics.md');
const { meta, breadcrumb, tags, hero, subnav, glance, evidence, problem, challenge, learningSolution, contentStrategy, experience, justInTime, visualGuide, reflection, nextCase } = entry.data;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="article"
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <!-- CASE HERO HEADER -->
  <header class="wrap" id="overview" aria-labelledby="case-title" style="padding-top: 2.5rem; text-align: left;">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">← Portfolio</a>
      <span class="separator">/</span>
      <span>{breadcrumb}</span>
    </nav>

    <div class="reveal">
      <div class="hero-meta-row" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
        <div class="card-tags">
          {
            tags.map((tag) => (
              <span class={tag.highlight ? 'tag-pill-sm highlight' : 'tag-pill-sm'}>{tag.label}</span>
            ))
          }
        </div>
        <a class="button button-primary" href="https://ergoapp-bgwt.onrender.com/" target="_blank" rel="noopener noreferrer">
          View Live App <span aria-hidden="true">↗</span>
        </a>
      </div>

      <h1 class="hero-name" id="case-title" style="font-size: clamp(2.8rem, 5.5vw, 4.5rem); margin-bottom: 0.75rem;">
        {hero.title}<span>.</span>
      </h1>

      <p class="hero-role-title" style="font-size: clamp(1.25rem, 2vw, 1.65rem); color: var(--ink-muted); font-weight: 600; margin-bottom: 1.5rem;">
        {hero.tagline}
      </p>

      <p class="hero-value-prop" style="margin-inline: 0; max-width: 820px; font-size: 1.15rem; line-height: 1.6; margin-bottom: 1.5rem;" set:html={hero.valueProp} />

      <div style="display: flex; justify-content: center; align-items: center; margin: 1rem auto 3rem;">
        <img src="/assets/projects/surgical-ergonomics/surgical-ergonomics-hero.png" alt="Surgical Ergonomics Companion Hero mockup" style="width: 100%; max-width: 850px; height: auto; display: block;" />
      </div>
    </div>
  </header>

  <!-- IN-PAGE STICKY SUBNAV -->
  <nav class="case-subnav" aria-label="Case study navigation">
    <div class="wrap">
      <ul class="case-subnav-list custom-subnav">
        {
          subnav.map((item, index) => (
            <li>
              <a href={item.href} class={index === 0 ? 'is-active' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- AT A GLANCE -->
  <section class="wrap at-a-glance-section" aria-labelledby="glance-heading">
    <h2 id="glance-heading" class="sr-only">Project At A Glance</h2>
    <div class="at-a-glance-grid">
      {
        glance.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon" aria-hidden="true">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- EVIDENCE & PROBLEM SECTION -->
  {(evidence || problem) && (
    <section class="wrap section" id="problem" aria-labelledby="problem-heading" style="padding-top: 4rem;">
      {evidence && (
        <div style="margin-bottom: 5rem;">
          <div class="section-heading reveal">
            <p class="eyebrow">{evidence.eyebrow}</p>
            <h2 id="problem-heading">The Problem<span>.</span></h2>
          </div>

          <div class="reveal" style="margin-bottom: 2rem;">
            <h3 style="font-size: 2.2rem; font-family: var(--display); margin-bottom: 1rem; letter-spacing: -0.02em;">{evidence.heading}</h3>
            <p style="font-size: 1.15rem; line-height: 1.65; max-width: 800px; color: var(--ink-muted);" set:html={evidence.intro} />
          </div>

          <div class="evidence-data-strip reveal" data-delay="1">
            {evidence.stats.map((stat) => {
              const valueHTML = stat.value.includes('ONLY') 
                ? `<span style="font-size: 0.4em; display: block; line-height: 1; letter-spacing: 0.05em; color: var(--ink-muted); margin-bottom: 0.2rem;">ONLY</span>${stat.value.replace('ONLY ', '')}` 
                : stat.value;
                
              return (
                <div class="data-strip-item">
                  <span class="data-value" set:html={valueHTML}></span>
                  <p class="data-desc">{stat.description}</p>
                </div>
              );
            })}
          </div>

          {evidence.takeaway && (
            <div class="reveal evidence-takeaway">
              <p>{evidence.takeaway}</p>
            </div>
          )}

          {evidence.sources && (
            <div class="reveal evidence-sources">
              <p>Sources</p>
              <ul>
                {evidence.sources.map((src) => (
                  <li>{src}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      {problem && (
        <div class="split-layout">
          <div class="split-text-block reveal">
            {problem.eyebrow && <p class="eyebrow">{problem.eyebrow}</p>}
            <h3 style="font-size: 2.2rem; font-family: var(--display); margin-bottom: 1.5rem; letter-spacing: -0.02em;">{problem.heading}</h3>
            <p style="font-size: 1.15rem; line-height: 1.65; margin-bottom: 1.5rem; color: var(--ink-muted);" set:html={problem.context} />
            <p style="font-size: 1.1rem; line-height: 1.65;" set:html={problem.body} />
          </div>
          
          <div class="split-visual-frame reveal" data-delay="1">
            <div class="naked-media" style="max-width: 550px; width: 100%;">
              <video class="case-video" controls playsinline preload="metadata">
                <source src="/assets/projects/surgical-ergonomics/surgical-ergonomics-posture-demo.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      )}
    </section>
  )}

  <!-- THE CHALLENGE -->
  {challenge && (
    <section class="wrap section" id="challenge" aria-labelledby="challenge-heading" style="padding-top: 4.5rem;">
      <div class="split-layout" style="align-items: flex-start;">
        <div class="split-text-block reveal" style="max-width: 650px;">
          <p class="eyebrow">{challenge.eyebrow}</p>
          <h2 id="challenge-heading">{challenge.heading}<span>.</span></h2>
          
          <div class="challenge-content-area" set:html={challenge.body} />
          
          <div class="refined-takeaway-box">
            <p>{challenge.takeaway}</p>
          </div>
        </div>

        <div class="split-visual-frame reveal" data-delay="1" style="justify-content: flex-start; align-items: center;">
          <div class="performance-card">
            <div class="performance-card-eyebrow">Target Goals</div>
            <h4 class="performance-card-title">Performance Objectives</h4>
            {challenge.problems && (
              <ul class="performance-card-list">
                {challenge.problems.map((prob) => (
                  <li>{prob}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- THE LEARNING SOLUTION -->
  {learningSolution && (
    <section class="wrap section" id="solution" aria-labelledby="solution-heading" style="padding-top: 4.5rem;">
      <div class="split-layout">
        <div class="split-text-block reveal">
          <p class="eyebrow">{learningSolution.eyebrow}</p>
          <h2 id="solution-heading">{learningSolution.heading}<span>.</span></h2>
          <p class="hook" style="font-size: 1.15rem; line-height: 1.65; color: var(--ink-muted); margin-bottom: 1.5rem;" set:html={learningSolution.context} />
          <p style="font-size: 1.1rem; line-height: 1.65;" set:html={learningSolution.body} />
        </div>
        
        <div class="split-visual-frame reveal" data-delay="1" style="justify-content: center;">
          <div class="css-iphone-mockup zoomable-container" style="max-width: 320px; width: 100%;">
            <div class="iphone-screen">
              <img src="/assets/projects/surgical-ergonomics/surgical-ergonomics-modules.jpeg" alt="Module selection screen" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            </div>
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CONTENT STRATEGY -->
  {contentStrategy && (
    <section class="wrap section" id="strategy" aria-labelledby="strategy-heading" style="padding-top: 4.5rem;">
      <div class="section-heading reveal">
        <p class="eyebrow">{contentStrategy.eyebrow}</p>
        <h2 id="strategy-heading">{contentStrategy.heading}<span>.</span></h2>
        <p class="hook" style="font-size: 1.15rem; line-height: 1.65; max-width: 800px;" set:html={contentStrategy.body} />
      </div>

      <div class="process-grid" style="margin-bottom: 2rem;">
        {contentStrategy.decisions.map((decision, index) => (
          <article class="process-card reveal" data-delay={index + 1}>
            <div class="process-number">
              <span>0{index + 1}</span>
            </div>
            <div class="process-content">
              <h3>{decision.title}</h3>
              <p set:html={decision.body} />
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- JUST-IN-TIME ACCESS -->
  {justInTime && (
    <section class="wrap section" id="just-in-time" aria-labelledby="jit-heading" style="padding-top: 4.5rem;">
      <div class="split-layout" style="align-items: center;">
        <div class="split-text-block reveal" style="max-width: 600px;">
          <p class="eyebrow">{justInTime.eyebrow}</p>
          <h2 id="jit-heading">{justInTime.heading}<span>.</span></h2>
          
          <div class="challenge-content-area" style="gap: 1.5rem; margin-bottom: 2rem;">
            <p style="font-size: 1.1rem; line-height: 1.7; color: var(--ink-muted); margin: 0;" set:html={justInTime.body} />
          </div>
          
          {justInTime.followUp && (
            <div class="refined-takeaway-box">
              <p>{justInTime.followUp}</p>
            </div>
          )}
        </div>
        
        <div class="split-visual-frame reveal" data-delay="1" style="justify-content: center;">
          <div class="naked-media zoomable-container" style="width: 100%; max-width: 400px; border: 1px solid var(--line, rgba(26,26,26,0.08)); border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,0.06);">
            <img src="/assets/projects/surgical-ergonomics/ergo-poster.png" alt="Surgical Ergonomics QR Poster" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- THE LEARNING EXPERIENCE -->
  {experience && (
    <section class="wrap section" id="experience" aria-labelledby="experience-heading" style="padding-top: 4.5rem;">
      <div class="split-layout">
        <div class="split-text-block reveal">
          <p class="eyebrow">{experience.eyebrow}</p>
          <h2 id="experience-heading">{experience.heading}<span>.</span></h2>
          {experience.body && <p class="hook" style="font-size: 1.15rem; line-height: 1.65; margin-bottom: 1.5rem;" set:html={experience.body} />}
          {experience.flow && <div style="font-size: 1.1rem; line-height: 1.65;" set:html={experience.flow} />}
        </div>
        
        <div class="split-visual-frame reveal" data-delay="1" style="justify-content: center;">
          <div class="css-iphone-mockup" style="max-width: 320px; width: 100%;">
            <div class="iphone-screen">
              <video class="case-video" controls playsinline preload="metadata">
                <source src="/assets/projects/surgical-ergonomics/surgical-ergonomics-full-flow.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}


  <!-- THE VISUAL GUIDE -->
  {visualGuide && (
    <section class="wrap section" id="guide" aria-labelledby="guide-heading" style="padding-top: 4.5rem;">
      <div class="split-layout">
        <div class="split-text-block reveal">
          <p class="eyebrow">{visualGuide.eyebrow}</p>
          <h2 id="guide-heading">{visualGuide.heading}<span>.</span></h2>
          <p style="font-size: 1.15rem; line-height: 1.65; margin-bottom: 1.5rem; color: var(--ink-muted);" set:html={visualGuide.body} />
          <p style="font-size: 1.1rem; line-height: 1.65;" set:html={visualGuide.impact} />
        </div>
        
        <div class="split-visual-frame reveal" data-delay="1">
          <div class="naked-media zoomable-container" style="max-width: 320px; width: 100%;">
            <img src="/assets/projects/surgical-ergonomics/surgical-ergonomics-heygen-avatar.png" alt="AI Visual Guide Character" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- REFLECTION -->
  {reflection && (
    <section class="wrap section" id="reflection" aria-labelledby="reflection-heading" style="padding-top: 4.5rem;">
      <div class="section-heading reveal">
        <p class="eyebrow">{reflection.eyebrow}</p>
        <h2 id="reflection-heading">{reflection.heading}<span>.</span></h2>
        <p class="hook" style="font-size: 1.15rem; line-height: 1.65; max-width: 800px;" set:html={reflection.body} />
      </div>


    </section>
  )}

  <!-- LIGHTBOX MODAL -->
  <div id="image-lightbox" class="lightbox-modal" aria-hidden="true">
    <div class="lightbox-backdrop" aria-label="Close modal"></div>
    <div class="lightbox-content" role="dialog" aria-modal="true" aria-label="Enlarged screenshot">
      <button class="lightbox-close" aria-label="Close zoom">✕</button>
      <img id="lightbox-image" src="" alt="Enlarged screenshot" />
    </div>
  </div>
</BaseLayout>

<script>
  // Lightbox Implementation
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('lightbox-image');
  const closeBtn = document.querySelector('.lightbox-close');
  const backdrop = document.querySelector('.lightbox-backdrop');
  const zoomables = document.querySelectorAll('.zoomable-image');
  const zoomButtons = document.querySelectorAll('.zoom-button');
  
  let previouslyFocusedElement = null;

  function openLightbox(src) {
    previouslyFocusedElement = document.activeElement;
    if (lightboxImg && lightbox) {
      lightboxImg.src = src;
      lightbox.setAttribute('aria-hidden', 'false');
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden'; // Prevent scrolling
      if (closeBtn) closeBtn.focus();
    }
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.setAttribute('aria-hidden', 'true');
      lightbox.classList.remove('is-open');
      document.body.style.overflow = ''; 
      if (previouslyFocusedElement) {
        previouslyFocusedElement.focus();
      }
    }
  }

  // Bind click/keyboard events to zoomable images and buttons
  zoomables.forEach(img => {
    img.addEventListener('click', () => openLightbox(img.src));
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(img.src);
      }
    });
  });

  zoomButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const img = btn.previousElementSibling;
      if (img && img.tagName === 'IMG') {
        openLightbox(img.src);
      }
    });
  });

  // Close events
  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && lightbox.classList.contains('is-open')) {
      closeLightbox();
    }
  });
</script>

<style>
  /* SUBNAV REFINEMENT */
  .custom-subnav {
    flex-wrap: nowrap !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  .custom-subnav::-webkit-scrollbar {
    display: none;
  }
  .custom-subnav li {
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .custom-subnav {
      justify-content: center !important;
      gap: 1.5rem !important;
    }
    .custom-subnav a {
      font-size: 0.9rem !important;
      padding: 0.5rem 0.2rem !important;
    }
  }
  @media (min-width: 1024px) {
    .custom-subnav {
      gap: 2rem !important;
    }
    .custom-subnav a {
      font-size: 0.95rem !important;
    }
  }

  /* EDITORIAL SPLIT LAYOUT */
  .split-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: center;
  }
  .split-text-block {
    width: 100%;
    max-width: 700px;
  }
  .split-visual-frame {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    overflow: visible;
  }
  @media (min-width: 900px) {
    .split-layout {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
    .split-text-block {
      flex: 1 1 55%;
      max-width: 600px;
    }
    .split-visual-frame {
      flex: 1 1 45%;
      justify-content: flex-start;
    }
    /* When reversed, put image close to text on the right */
    .split-layout[style*="row-reverse"] .split-visual-frame {
      justify-content: flex-end;
    }
  }

  /* IPHONE MOCKUP CSS */
  .css-iphone-mockup {
    position: relative;
    border: 10px solid #1a1a1a;
    border-radius: 40px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.1), inset 0 0 0 3px #333;
    background: #000;
    overflow: hidden;
  }
  /* Dynamic notch */
  .css-iphone-mockup::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 24px;
    background: #1a1a1a;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    z-index: 10;
  }
  .iphone-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 19.5;
    background: #fff;
    overflow: hidden;
    border-radius: 30px;
  }
  .iphone-screen video, .iphone-screen img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* PROCESS CARDS GRID */
  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 600px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .process-card {
    background: var(--paper, #ffffff);
    padding: 2rem 1.5rem;
    border-radius: 20px;
    border: 1px solid var(--line, rgba(26,26,26,0.08));
    box-shadow: 0 8px 24px rgba(0,0,0,0.03);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s var(--ease);
    height: 100%;
    cursor: default;
  }
  
  .process-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    border-color: rgba(239, 108, 53, 0.3);
  }

  .process-number {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: rgba(239, 108, 53, 0.1);
    color: var(--orange);
    border-radius: 12px;
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .process-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .process-content p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  /* EVIDENCE DATA STRIP */
  .evidence-data-strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 3.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--line, rgba(26,26,26,0.08));
    border-bottom: 1px solid var(--line, rgba(26,26,26,0.08));
  }
  
  @media (min-width: 600px) {
    .evidence-data-strip {
      grid-template-columns: 1fr 1fr;
      gap: 3rem 2rem;
    }
  }
  
  @media (min-width: 900px) {
    .evidence-data-strip {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      padding: 3.5rem 0;
    }
    .data-strip-item:not(:last-child) {
      border-right: 1px solid var(--line, rgba(26,26,26,0.08));
      padding-right: 1.5rem;
    }
  }

  .data-strip-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .data-value {
    font-family: var(--display);
    font-size: clamp(3rem, 4vw, 4rem);
    font-weight: 800;
    color: var(--orange);
    line-height: 1;
    margin-bottom: 1rem;
    display: block;
  }

  .data-desc {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }

  .evidence-takeaway {
    text-align: center;
    margin: 3.5rem auto 0;
    max-width: 750px;
  }
  
  .evidence-takeaway p {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.6;
    margin: 0;
  }

  .evidence-takeaway p::after {
    content: '';
    display: block;
    width: 40px;
    height: 3px;
    background: var(--orange);
    margin: 1.5rem auto 0;
    border-radius: 2px;
  }

  .evidence-sources {
    text-align: center;
    margin-top: 3.5rem;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .evidence-sources p {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem 0;
  }
  .evidence-sources ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
