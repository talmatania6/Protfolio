---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const caseEntry = await getEntry('cases', 'my-first-shift');
if (!caseEntry) {
  throw new Error('Case study not found: my-first-shift');
}

const { 
  meta,
  breadcrumb,
  tags,
  subnav,
  glance,
  project, 
  hero, 
  overview, 
  problem, 
  challenge, 
  learningSolution, 
  contentStrategy, 
  experience, 
  assessment,
  inUseToday,
  nextCase 
} = caseEntry.data;

const storylineUrl =
  'https://360.articulate.com/review/content/8308d52e-0a90-4e3b-8485-96bbe8272bff/review';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="article"
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <!-- CASE HERO HEADER -->
  <header class="wrap" id="overview" aria-labelledby="case-title" style="padding-top: 2.5rem; text-align: left;">
    <div class="hero-split-layout">
      <div class="hero-split-text reveal">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
          <a href="/">← Portfolio</a>
          <span class="separator">/</span>
          <span>{breadcrumb}</span>
        </nav>

        <div class="card-tags" style="margin-bottom: 1.5rem;">
          {
            tags.map((tag) => (
              <span class={tag.highlight ? 'tag-pill-sm highlight' : 'tag-pill-sm'}>{tag.label}</span>
            ))
          }
        </div>

        <h1 class="hero-name" id="case-title" style="font-size: clamp(2.8rem, 5vw, 4.5rem); margin-bottom: 0.75rem;">
          {hero.title}<span>.</span>
        </h1>

        <p class="hero-role-title" style="font-size: clamp(1.15rem, 2vw, 1.5rem); color: var(--ink-muted); font-weight: 600; margin-bottom: 1.5rem;">
          {hero.tagline}
        </p>

        <p class="hero-value-prop" style="margin-inline: 0; max-width: 820px; font-size: 1.15rem; line-height: 1.6; margin-bottom: 2.5rem;" set:html={hero.valueProp} />

        <div>
          <a class="button button-primary" href={storylineUrl} target="_blank" rel="noopener noreferrer">
            View Live Module <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      
      <div class="hero-split-visual reveal" data-delay="1">
        <img src="/assets/images/computer-my-first-shift.png" alt="My First Shift - Interactive Storyline Experience Hero mockup" style="width: 100%; max-width: 1000px; height: auto; display: block;" />
      </div>
    </div>
  </header>

  <!-- IN-PAGE STICKY SUBNAV -->
  <nav class="case-subnav" aria-label="Case study navigation">
    <div class="wrap">
      <ul class="case-subnav-list custom-subnav">
        {
          subnav.map((item, index) => (
            <li>
              <a href={item.href} class={index === 0 ? 'is-active' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- AT A GLANCE -->
  <section class="wrap at-a-glance-section" aria-labelledby="glance-heading">
    <h2 id="glance-heading" class="sr-only">Project At A Glance</h2>
    <div class="at-a-glance-grid">
      {
        glance.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon" aria-hidden="true">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- THE PROBLEM -->
  {problem && (
    <section class="wrap section" id="problem" aria-labelledby="problem-heading" style="padding-top: 3.5rem;">
      <div class="split-alternating">
        <div class="split-text-block reveal" style="max-width: 650px;">
          <p class="eyebrow">{problem.eyebrow}</p>
          <h2 id="problem-heading">{problem.heading}<span>.</span></h2>
          <p style="font-size: 1.15rem; line-height: 1.65; margin-bottom: 1.5rem; color: var(--ink-muted);" set:html={problem.context} />
          <p style="font-size: 1.1rem; line-height: 1.65;" set:html={problem.body} />
        </div>
        
        <div class="split-visual-frame reveal" data-delay="1">
          <div class="case-media-frame">
            <video class="case-video" controls playsinline preload="metadata">
              <source src="/assets/images/my-first-shift-challenge.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- THE CHALLENGE -->
  {challenge && (
    <section class="wrap section" id="challenge" aria-labelledby="challenge-heading" style="padding-top: 2rem;">
      <div class="split-alternating" style="flex-direction: row-reverse;">
        <div class="split-text-block reveal" style="max-width: 650px;">
          <p class="eyebrow">{challenge.eyebrow}</p>
          <h2 id="challenge-heading">{challenge.heading}<span>.</span></h2>
          <p style="font-size: 1.1rem; line-height: 1.65; margin-bottom: 1.5rem;" set:html={challenge.body} />
          
          <div class="takeaway-box" style="margin-bottom: 2rem;">
            <p style="font-size: 1.05rem;"><strong>{challenge.takeaway}</strong></p>
          </div>
        </div>

        <div class="split-visual-frame reveal" data-delay="1" style="display: flex; flex-direction: column; justify-content: center;">
          <span style="font-size: 0.75rem; font-weight: 800; color: var(--orange); text-transform: uppercase; letter-spacing: 0.06em;">Target Goals</span>
          <h4 style="font-size: 1.25rem; margin: 0.5rem 0 1rem;">Performance Objectives</h4>
          {challenge.problems && (
            <ul style="padding-left: 1.25rem; margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--ink);">
              {challenge.problems.map((prob) => (
                <li style="margin-bottom: 0.75rem;">{prob}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- THE LEARNING SOLUTION -->
  {learningSolution && (
    <section class="wrap section" id="solution" aria-labelledby="solution-heading" style="padding-top: 2rem;">
      <div class="section-heading reveal">
        <p class="eyebrow">{learningSolution.eyebrow}</p>
        <h2 id="solution-heading">{learningSolution.heading}<span>.</span></h2>
        <p class="hook" style="font-size: 1.15rem; line-height: 1.65; max-width: 800px; color: var(--ink-muted);" set:html={learningSolution.context} />
        <p style="font-size: 1.1rem; line-height: 1.65; max-width: 800px; margin-top: 1.5rem;" set:html={learningSolution.body} />
      </div>
    </section>
  )}

  <!-- CONTENT STRATEGY -->
  {contentStrategy && (
    <section class="wrap section" id="strategy" aria-labelledby="strategy-heading">
      <div class="section-heading reveal">
        <p class="eyebrow">{contentStrategy.eyebrow}</p>
        <h2 id="strategy-heading">{contentStrategy.heading}<span>.</span></h2>
        <p class="hook" style="font-size: 1.15rem; line-height: 1.65; max-width: 800px;" set:html={contentStrategy.body} />
      </div>

      <div class="at-a-glance-grid" style="margin-bottom: 3.5rem;">
        {contentStrategy.decisions.map((decision, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <h3 style="font-size: 1.1rem; color: var(--orange);">{decision.title}</h3>
            <p style="font-size: 1rem; line-height: 1.6;" set:html={decision.body} />
          </article>
        ))}
      </div>

      <!-- The Learning Experience & Service Flow Architecture -->
      <div class="case-media-center reveal" style="margin-top: 4.5rem;">
        <div class="case-media-frame zoomable-container">
          <img src="/assets/images/my-first-shift-service-cycle.png" alt="Service cycle learning hub" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
          <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
        </div>
        <p style="text-align: center; max-width: 700px; margin: 1.5rem auto 0; font-size: 1.05rem; color: var(--ink-muted);" set:html={contentStrategy.architecture} />
      </div>
    </section>
  )}

  <!-- THE LEARNING EXPERIENCE -->
  {experience && (
    <section class="wrap section" id="experience" aria-labelledby="experience-heading">
      <div class="section-heading reveal">
        <p class="eyebrow">{experience.eyebrow}</p>
        <h2 id="experience-heading">{experience.heading}<span>.</span></h2>
        {experience.body && <p class="hook" style="font-size: 1.15rem; line-height: 1.65; max-width: 800px;" set:html={experience.body} />}
      </div>

      <!-- Interactive Video Experience -->
      <div class="reveal" style="margin-top: 3.5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">{experience.interactiveVideo.heading}</h3>
        <p style="font-size: 1.05rem; color: var(--ink-muted); margin-bottom: 1.5rem; max-width: 800px;" set:html={experience.interactiveVideo.body} />
        <div class="case-media-wide" style="margin-top: 0;">
          <div class="case-media-frame">
            <video class="case-video" controls playsinline preload="metadata">
              <source src="/assets/images/my-first-shift-order-taking-interaction.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </div>

      <!-- Learn -> Practice visual pairs (Pair A) -->
      <div class="reveal" style="margin-top: 5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">{experience.learnPractice.heading}</h3>
        <p style="font-size: 1.05rem; color: var(--ink-muted); margin-bottom: 1.5rem; max-width: 800px;" set:html={experience.learnPractice.body} />
        <div class="case-media-grid" style="margin-top: 0;">
          <div class="case-media-frame zoomable-container">
            <img src="/assets/images/my-first-shift-step-by-step-interaction.png" alt="Learn step-by-step" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
          <div class="case-media-frame zoomable-container">
            <img src="/assets/images/my-first-shift-sequencing-practice.png" alt="Practice sequencing" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>

      <!-- Scenario-Based Knowledge Check -->
      <div class="reveal" style="margin-top: 5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; text-align: center;">{experience.knowledgeCheck.heading}</h3>
        <p style="font-size: 1.05rem; color: var(--ink-muted); margin-bottom: 2rem; text-align: center; max-width: 700px; margin-inline: auto;" set:html={experience.knowledgeCheck.body} />
        <div class="case-media-center" style="margin-top: 0;">
          <div class="case-media-frame zoomable-container">
            <img src="/assets/images/my-first-shift-scenario-knowledge-check.png" alt="Scenario knowledge check" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>

      <!-- Task Prioritization -> Practice (Pair B) -->
      <div class="reveal" style="margin-top: 5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">{experience.prioritization.heading}</h3>
        <p style="font-size: 1.05rem; color: var(--ink-muted); margin-bottom: 1.5rem; max-width: 800px;" set:html={experience.prioritization.body} />
        <div class="case-media-grid" style="margin-top: 0;">
          <div class="case-media-frame zoomable-container">
            <img src="/assets/images/my-first-shift-task-prioritization.png" alt="Learn task prioritization" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
          <div class="case-media-frame zoomable-container">
            <img src="/assets/images/my-first-shift-prioritization-practice.png" alt="Practice prioritization" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>

      <!-- Learning Progression -->
      <div class="reveal" style="margin-top: 5rem;">
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; text-align: center;">{experience.progression.heading}</h3>
        <p style="font-size: 1.05rem; color: var(--ink-muted); margin-bottom: 2rem; text-align: center; max-width: 700px; margin-inline: auto;" set:html={experience.progression.body} />
        <div class="case-media-center" style="margin-top: 0;">
          <div class="case-media-frame zoomable-container">
            <img src="/assets/images/my-first-shift-learning-progress.png" alt="Learning progression" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ASSESSMENT -->
  {assessment && (
    <section class="wrap section" id="assessment" aria-labelledby="assessment-heading">
      <div class="section-heading reveal">
        <p class="eyebrow">{assessment.eyebrow}</p>
        <h2 id="assessment-heading">{assessment.heading}<span>.</span></h2>
        <p class="hook" style="font-size: 1.15rem; line-height: 1.65; max-width: 800px;" set:html={assessment.body} />
      </div>

      <div class="case-media-center reveal" style="margin-top: 3.5rem;">
        <div class="case-media-frame zoomable-container">
          <img src="/assets/images/my-first-shift-certification-unlocked.png" alt="Certification unlocked" class="case-media zoomable-image" loading="lazy" decoding="async" tabindex="0" aria-label="Zoom image" />
          <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
        </div>
        
        {assessment.techOutput && (
          <p style="text-align: center; margin-top: 1.5rem; font-size: 0.95rem; font-weight: 600; color: var(--ink-muted);">
            {assessment.techOutput}
          </p>
        )}
        <div style="text-align: center; margin-top: 2rem;">
          <a class="button button-primary" href={storylineUrl} target="_blank" rel="noopener noreferrer">
            View Live Module <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Navigation to Next Case -->
      {nextCase && (
        <div style="text-align: left; margin-top: 6rem;" class="reveal">
          <a class="button button-dark" href={nextCase.href}>
            {nextCase.label} <span aria-hidden="true">→</span>
          </a>
        </div>
      )}
    </section>
  )}

  <!-- IN USE TODAY -->
  {inUseToday && (
    <section class="wrap section" id="in-use" aria-labelledby="in-use-heading" style="padding-top: 2rem;">
      <div class="section-heading reveal">
        <p class="eyebrow">{inUseToday.eyebrow}</p>
        <h2 id="in-use-heading">{inUseToday.heading}<span>.</span></h2>
        <div class="hook" style="font-size: 1.15rem; line-height: 1.65; max-width: 800px;">
          <p style="margin: 0;" set:html={inUseToday.body} />
        </div>
      </div>
      
      <div class="reveal" style="margin-bottom: 5rem;">
        <div style="margin-bottom: 1rem;">
          <span class="pill-badge" style="font-size: 0.8rem; padding: 0.4rem 1rem;">{inUseToday.highlight}</span>
        </div>
        <p style="font-size: 1.1rem; color: var(--ink-muted); margin: 0; max-width: 700px;">
          {inUseToday.microcopy}
        </p>
      </div>
      
      <div class="reveal" data-delay="1">
        <h4 style="font-size: 1.15rem; font-weight: 700; color: var(--ink); margin-bottom: 2rem; letter-spacing: 0.02em; text-transform: uppercase;">
          {inUseToday.feedbackTitle}
        </h4>
        <div class="feedback-grid">
          {inUseToday.testimonials.map((t: any) => (
            <div class="feedback-card">
              <div>
                <div class="quote-icon">“</div>
                <p class="feedback-quote">“{t.quote}”</p>
              </div>
              <p class="feedback-author">— {t.author}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- LIGHTBOX MODAL -->
  <div id="image-lightbox" class="lightbox-modal" aria-hidden="true">
    <div class="lightbox-backdrop" aria-label="Close modal"></div>
    <div class="lightbox-content" role="dialog" aria-modal="true" aria-label="Enlarged screenshot">
      <button class="lightbox-close" aria-label="Close zoom">✕</button>
      <img id="lightbox-image" src="" alt="Enlarged screenshot" />
    </div>
  </div>
</BaseLayout>

<style>
  .hero-split-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-split-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
  }
  @media (min-width: 900px) {
    .hero-split-layout {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 5rem;
    }
    .hero-split-visual img {
      transform: scale(1.18);
      transform-origin: left center;
    }
  }
</style>
<script>
  // Lightbox Implementation
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('lightbox-image');
  const closeBtn = document.querySelector('.lightbox-close');
  const backdrop = document.querySelector('.lightbox-backdrop');
  const zoomables = document.querySelectorAll('.zoomable-image');
  const zoomButtons = document.querySelectorAll('.zoom-button');
  
  let previouslyFocusedElement = null;

  function openLightbox(src) {
    previouslyFocusedElement = document.activeElement;
    lightboxImg.src = src;
    lightbox.setAttribute('aria-hidden', 'false');
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden'; // Prevent scrolling
    closeBtn.focus();
  }

  function closeLightbox() {
    lightbox.setAttribute('aria-hidden', 'true');
    lightbox.classList.remove('is-open');
    document.body.style.overflow = ''; 
    if (previouslyFocusedElement) {
      previouslyFocusedElement.focus();
    }
  }

  // Bind click/keyboard events to zoomable images and buttons
  zoomables.forEach(img => {
    img.addEventListener('click', () => openLightbox(img.src));
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(img.src);
      }
    });
  });

  zoomButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const img = btn.previousElementSibling;
      if (img && img.tagName === 'IMG') {
        openLightbox(img.src);
      }
    });
  });

  // Close events
  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox.classList.contains('is-open')) {
      closeLightbox();
    }
  });
</script>

<style>
  /* FEEDBACK GRID */
  .feedback-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .feedback-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
  .feedback-card {
    background: var(--paper-card, #fafafa);
    padding: 3rem 2.5rem;
    border-radius: 12px;
    border: 1px solid var(--line, rgba(26,26,26,0.08));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }
  .quote-icon {
    font-family: var(--display);
    font-size: 3.5rem;
    line-height: 0.5;
    color: var(--orange);
    opacity: 0.4;
    margin-bottom: 1.5rem;
    margin-top: 0.5rem;
  }
  .feedback-quote {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--ink);
    font-style: italic;
    margin: 0 0 2.5rem 0;
  }
  .feedback-author {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  /* SUBNAV REFINEMENT */
  .custom-subnav {
    flex-wrap: nowrap !important;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  .custom-subnav::-webkit-scrollbar {
    display: none;
  }
  .custom-subnav li {
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .custom-subnav {
      justify-content: center !important;
      gap: 1.5rem !important;
    }
    .custom-subnav a {
      font-size: 0.9rem !important;
      padding: 0.5rem 0.2rem !important;
    }
  }
  @media (min-width: 1024px) {
    .custom-subnav {
      gap: 2rem !important;
    }
    .custom-subnav a {
      font-size: 0.95rem !important;
    }
  }

  .case-media-frame {
    background: var(--paper-card, #ffffff);
    border: 1px solid var(--line, rgba(26, 26, 26, 0.08));
    border-radius: var(--radius-md, 14px);
    overflow: hidden;
    box-shadow: var(--shadow-sm, 0 4px 16px rgba(26, 26, 26, 0.03));
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
  }
  
  .case-media {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  
  .case-media-wide {
    width: 100%;
    margin-top: 3.5rem;
  }
  
  .case-media-center {
    width: 90%;
    max-width: 960px;
    margin: 3.5rem auto 0;
  }

  .case-media-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 3.5rem;
  }
  
  @media (min-width: 768px) {
    .case-media-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .case-video {
    width: 100%;
    height: auto;
    display: block;
    border-radius: inherit;
  }

  /* Lightbox / Zoom Functionality */
  .zoomable-container {
    position: relative;
    cursor: zoom-in;
  }

  .zoomable-image {
    transition: transform 0.3s ease;
  }
  
  .zoomable-image:focus {
    outline: 2px solid var(--orange, #ff6b35);
    outline-offset: -2px;
  }

  .zoom-button {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: zoom-in;
    opacity: 0;
    transition: opacity 0.2s ease, background 0.2s ease;
    pointer-events: none; /* Let the container handle the click */
