---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('cases', 'learning-game-generator');
if (!entry) throw new Error('Missing src/content/cases/learning-game-generator.md');
const { meta, breadcrumb, tags, hero, subnav, glance, nextCase } = entry.data;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="article"
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <!-- CASE HERO HEADER (LEFT-ALIGNED, DUAL MOCKUPS) -->
  <header class="wrap" id="overview" aria-labelledby="case-title" style="padding-top: 2.5rem; text-align: left;">
    <div class="hero-split-layout">
      <div class="hero-split-text reveal">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
          <a href="/">← Portfolio</a>
          <span class="separator">/</span>
          <span>{breadcrumb}</span>
        </nav>

        <div class="card-tags" style="margin-bottom: 1.5rem;">
          {
            tags.map((tag) => (
              <span class={tag.highlight ? 'tag-pill-sm highlight' : 'tag-pill-sm'}>{tag.label}</span>
            ))
          }
        </div>

        <h1 class="hero-name" id="case-title" style="font-size: clamp(2.8rem, 5vw, 4.5rem); margin-bottom: 0.75rem;">
          {hero.title}<span>.</span>
        </h1>

        <p class="hero-role-title" style="font-size: clamp(1.15rem, 2vw, 1.5rem); color: var(--ink-muted); font-weight: 600; margin-bottom: 1.5rem;">
          {hero.tagline}
        </p>

        <p class="hero-value-prop" style="margin-inline: 0; max-width: 820px; font-size: 1.15rem; line-height: 1.6; margin-bottom: 2.5rem;" set:html={hero.valueProp} />

        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a class="button button-primary" href="https://triangle.telem-hit.net/2026/PlaneItRight_NitzanLironTalMika/" target="_blank" rel="noopener noreferrer">
            View Live Project <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-dark" href="#experience">
            View Full Game Walkthrough ↓
          </a>
        </div>
      </div>
      
      <div class="hero-split-visual reveal" data-delay="1">
        <div class="dual-mockup-container">
          <div class="mockup-player-wrapper">
            <img class="mockup-player" src="/assets/projects/plane-it-right/plane-it-right-player-mockup.png" alt="Plane It Right Player Interface" />
          </div>
          <div class="mockup-editor-wrapper">
            <img class="mockup-editor" src="/assets/projects/plane-it-right/plane-it-right-editor-mockup.png" alt="Plane It Right Editor Interface" />
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- IN-PAGE STICKY SUBNAV WITH ACTIVE HIGHLIGHT -->
  <nav class="case-subnav" aria-label="Case study navigation">
    <div class="wrap">
      <ul class="case-subnav-list custom-subnav">
        {
          subnav.map((item, index) => (
            <li>
              <a href={item.href} class={index === 0 ? 'is-active' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- OVERVIEW / "AT A GLANCE" SECTION -->
  <section class="wrap at-a-glance-section" aria-labelledby="glance-heading">
    <h2 id="glance-heading" class="sr-only">Project At A Glance</h2>
    <div class="at-a-glance-grid">
      {
        glance.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon" aria-hidden="true">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="wrap section" id="problem" aria-labelledby="problem-heading" style="padding-top: 2rem;">
    <div class="split-layout">
      <div class="split-text-block reveal">
        <p class="eyebrow">01 / The Problem</p>
        <h2 id="problem-heading">From Static Content to Active Practice<span>.</span></h2>
        <p style="font-size: 1.15rem; line-height: 1.65; margin-bottom: 1.5rem; color: var(--ink-muted);">
          <strong>Educators and learning professionals</strong> often need to create engaging learning activities quickly, but building an interactive activity for every new topic requires time, technical knowledge, or specialized authoring tools.
        </p>
        <p style="font-size: 1.1rem; line-height: 1.65; margin-bottom: 1.5rem;">
          For <strong>learners (specifically in elementary school)</strong>, existing learning methods can make it difficult to stay engaged and actively apply what they are learning. Static exercises often provide limited opportunities to learn through doing or receive immediate feedback, making practice feel passive rather than interactive. This can reduce engagement and limit opportunities for learners to repeatedly apply and reinforce their knowledge.
        </p>
        <p style="font-size: 1.1rem; line-height: 1.65;">
          Plane It Right was designed to address both needs: giving educators a flexible way to turn their own content into an interactive learning activity, while giving learners a game-based environment for practicing learning material.
        </p>
      </div>
      
      <div class="split-visual-frame text-only-frame reveal" data-delay="1">
         <div style="background: var(--surface); padding: 2.5rem; border-radius: 12px; border: 1px solid var(--border); box-shadow: 0 8px 30px rgba(0,0,0,0.04);">
            <h4 style="font-family: var(--display); font-size: 1.25rem; margin-bottom: 1rem;">The Need</h4>
            <ul style="margin: 0; padding-left: 1.5rem; color: var(--ink-muted); line-height: 1.8;">
              <li><strong>Quick, reusable authoring</strong> for educators</li>
              <li><strong>Immediate feedback</strong> for learners</li>
              <li><strong>Learning through doing</strong> rather than passive recall</li>
              <li><strong>Engaging practice</strong> that encourages continued participation</li>
              <li><strong>Scalable instructional design</strong></li>
            </ul>
         </div>
      </div>
    </div>
  </section>

  <!-- THE CHALLENGE -->
  <section class="wrap section" id="challenge" aria-labelledby="challenge-heading">
    <div class="split-layout reverse">
      <div class="split-text-block reveal">
        <p class="eyebrow">02 / The Challenge</p>
        <h2 id="challenge-heading">One Product, Two Very Different Users<span>.</span></h2>
        <p style="font-size: 1.15rem; line-height: 1.65; margin-bottom: 1.5rem; color: var(--ink-muted);">
          A central challenge in Plane It Right was creating one product that serves two very different users concurrently.
        </p>
        <p style="font-size: 1.1rem; line-height: 1.65;">
          Educators needed an authoring environment that makes content creation manageable and flexible, while learners needed a game experience that feels immediate, intuitive, and motivating. The challenge was not just designing a game, but designing an end-to-end learning system that connects content creation, publishing, and gameplay into one coherent flow.
        </p>
      </div>

      <div class="split-visual-frame text-only-frame reveal" data-delay="1">
        <div style="display: grid; gap: 1.5rem; width: 100%;">
          <div style="background: var(--surface); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border);">
            <strong style="display: block; color: var(--orange); margin-bottom: 0.5rem; font-size: 1.1rem;">Educator Side</strong>
            <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted); line-height: 1.5;">Creating games, defining categories, adding items, and publishing content efficiently with AI support.</p>
          </div>
          <div style="background: var(--surface); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border);">
            <strong style="display: block; color: var(--primary); margin-bottom: 0.5rem; font-size: 1.1rem;">Learner Side</strong>
            <p style="margin: 0; font-size: 0.95rem; color: var(--ink-muted); line-height: 1.5;">Entering games, grasping rules quickly, playing responsive sorting games, and receiving feedback.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE LEARNING SOLUTION -->
  <section class="wrap section" id="solution" aria-labelledby="solution-heading">
    <div class="split-layout" style="align-items: flex-start;">
      <div class="split-text-block reveal" style="max-width: 650px;">
        <p class="eyebrow">03 / The Educator Solution</p>
        <h2 id="solution-heading">The Educator Solution<span>.</span></h2>
        <p style="font-size: 1.15rem; line-height: 1.65; color: var(--ink-muted);">
          The educator experience begins in the authoring interface, where a new game is created and configured. The educator defines the game content, creates categories, adds learning items, and prepares the activity for publication. Once published, the system generates a game code that learners can use to access the experience.
        </p>
      </div>

      <div class="split-visual-frame reveal" data-delay="1" style="width: 100%; align-items: flex-start;">
        <!-- 3-PART SYSTEM FLOW -->
        <div class="system-flow-container" style="display: flex; flex-direction: column; gap: 1.5rem; align-items: center;">
          <!-- Educator: Editor Interface -->
          <div class="flow-step step-large" style="width: 100%;">
            <div style="margin-bottom: 1rem; text-align: left;">
              <h4 class="flow-title" style="margin-bottom: 0.25rem;">01 &mdash; CREATE</h4>
              <p class="flow-desc" style="margin: 0; color: var(--ink-muted);">Build the game by defining categories and adding learning items.</p>
            </div>
            <div class="flow-image-wrapper zoomable-container">
              <img src="/assets/projects/plane-it-right/PlaneItRight-editorSide.png" alt="Educator Authoring Interface" class="zoomable-image" tabindex="0" aria-label="Zoom image" />
              <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
            </div>
          </div>

          <div class="flow-arrow" style="font-size: 2rem; color: var(--border);">↓</div>

          <!-- Educator: Authoring Flow -->
          <div class="flow-step step-large" style="width: 100%;">
            <div style="margin-bottom: 1rem; text-align: left;">
              <h4 class="flow-title" style="margin-bottom: 0.25rem;">02 &mdash; PUBLISH</h4>
              <p class="flow-desc" style="margin: 0; color: var(--ink-muted);">Review and publish the completed game from the educator dashboard.</p>
            </div>
            <div class="flow-image-wrapper zoomable-container">
              <img src="/assets/projects/plane-it-right/plane-it-right-flow-educator.png" alt="Game Creation Flow" class="zoomable-image" tabindex="0" aria-label="Zoom image" />
              <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
            </div>
          </div>

          <div class="flow-arrow" style="font-size: 2rem; color: var(--border);">↓</div>

          <!-- Game Code -->
          <div class="flow-step step-medium" style="width: 100%;">
            <div style="margin-bottom: 1rem; text-align: left;">
              <h4 class="flow-title" style="margin-bottom: 0.25rem;">03 &mdash; SHARE</h4>
              <p class="flow-desc" style="margin: 0; color: var(--ink-muted);">Share the generated 4-digit game code so learners can access the activity.</p>
            </div>
            <div class="flow-image-wrapper zoomable-container">
              <img src="/assets/projects/plane-it-right/plane-it-right-flow-game-code.png" alt="Game Code Generation" class="zoomable-image" tabindex="0" aria-label="Zoom image" />
              <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INSTRUCTIONAL DESIGN -->
  <section class="wrap section" id="instructional-design" aria-labelledby="id-heading">
    <div class="split-layout">
      <div class="split-text-block reveal">
        <p class="eyebrow">04 / The Learner Solution</p>
        <h2 id="id-heading">The Learner Solution<span>.</span></h2>
        <p style="font-size: 1.15rem; line-height: 1.65; margin-bottom: 1.5rem; color: var(--ink-muted);">
          The key instructional challenge was not simply to make a sorting game, but to ask: <em>How might we enable educators to turn their own learning content into an interactive, engaging practice experience quickly, while keeping the activity pedagogically meaningful?</em>
        </p>
        <p style="font-size: 1.1rem; line-height: 1.65; margin-bottom: 1.5rem;">
          The solution relies on a reusable game structure that can support different subject areas. The airport metaphor was selected specifically because it maps naturally onto the cognitive task of classification:
        </p>
        <ul style="margin: 0 0 1.5rem; padding-left: 1.5rem; color: var(--ink-muted); line-height: 1.8;">
          <li><strong>Learning item</strong> = Suitcase</li>
          <li><strong>Category</strong> = Destination</li>
          <li><strong>Sorting action</strong> = Sending the suitcase to the correct belt</li>
        </ul>
        <p style="font-size: 1.1rem; line-height: 1.65; margin-bottom: 1rem;">
          This ensures the learning action and the game action are the same action.
        </p>
      </div>

      <div class="split-visual-frame large-media-frame reveal" data-delay="1">
        <video style="width: 100%; display: block; border-radius: 12px;" controls preload="metadata" playsinline>
          <source src="/assets/projects/plane-it-right/DraggingRight.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <!-- AI & DEVELOPMENT -->
  <section class="wrap section" id="ai-development" aria-labelledby="dev-heading">
    <div class="split-layout" style="margin-bottom: 4rem;">
      <div class="split-text-block reveal">
        <p class="eyebrow">05 / Execution</p>
        <h2 id="dev-heading">AI-Assisted Authoring &amp; Technical Development<span>.</span></h2>
        <p style="font-size: 1.15rem; line-height: 1.65; color: var(--ink-muted); margin-bottom: 1.5rem;">
          Educators needed a faster way to create interactive practice. Plane It Right provides a reusable authoring system to solve this, and we deliberately embedded AI into the authoring workflow to make that process even faster.
        </p>
        <p style="font-size: 1.1rem; line-height: 1.65; color: var(--ink-muted);">
          By reducing the effort involved in creating individual learning items, the educator can publish the game more easily, and learners ultimately receive an engaging, interactive sorting experience.
        </p>
      </div>
    </div>

    <!-- AI-ASSISTED ITEM GENERATION -->
    <div class="split-layout tech-block reveal" style="margin-bottom: 6rem; align-items: center;">
      <div class="split-text-block">
        <h3 style="font-size: 1.8rem; font-family: var(--display); margin-bottom: 1.5rem;">AI-Assisted Item Generation</h3>
        <p style="font-size: 1.1rem; line-height: 1.65; color: var(--ink-muted); margin-bottom: 1.5rem;">
          AI was integrated at the point where content creation can become repetitive. When adding a text item, educators can generate a suggestion directly from the authoring interface.
        </p>
        <p style="font-size: 1.1rem; line-height: 1.65; color: var(--ink-muted); margin-bottom: 1.5rem;">
          The system uses the game topic, category, and existing content context to generate a relevant item, helping the educator move from an empty field to a usable starting point more quickly.
        </p>
        <div class="takeaway-box" style="margin-bottom: 1.5rem; padding: 1rem; border-left: 3px solid var(--orange); background: var(--surface); font-size: 1rem;">
          <strong style="color: var(--orange);">AI where the friction happens.</strong><br/>
          Context-aware suggestions directly inside the authoring workflow.
        </div>
        <p style="font-size: 1.1rem; line-height: 1.65; color: var(--ink-muted);">
          Rather than replacing the educator, AI acts as an authoring assistant — reducing repetitive work while keeping instructional control with the content creator.
        </p>
      </div>
      <div class="split-visual-frame large-media-frame">
        <div class="ai-process-sequence" style="display: flex; flex-direction: column; gap: 3rem; position: relative;">
          <!-- Visual connector line -->
          <div style="position: absolute; left: 1.5rem; top: 0; bottom: 0; width: 2px; background: var(--line, rgba(26,26,26,0.08)); z-index: 0;"></div>

          <!-- Step 1: Video -->
          <div class="ai-process-step" style="position: relative; z-index: 1; padding-left: 4rem;">
            <div style="position: absolute; left: 0; top: 0; width: 3rem; height: 3rem; background: var(--surface, #ffffff); border: 2px solid var(--line, rgba(26,26,26,0.08)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-weight: 700; color: var(--orange); font-size: 1.2rem; box-shadow: 0 4px 10px rgba(0,0,0,0.03);">1</div>
            <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--ink);">Educator Action</h4>
            <p style="font-size: 0.95rem; color: var(--ink-muted); margin-bottom: 1rem; line-height: 1.5;">The educator requests an item suggestion directly from the authoring interface.</p>
            <video style="width: 100%; display: block; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid var(--line, rgba(26,26,26,0.08));" controls preload="metadata" playsinline>
              <source src="/assets/projects/plane-it-right/ai-generate-video.mp4" type="video/mp4" />
            </video>
          </div>

          <!-- Step 2: Context -->
          <div class="ai-process-step" style="position: relative; z-index: 1; padding-left: 4rem;">
            <div style="position: absolute; left: 0; top: 0; width: 3rem; height: 3rem; background: var(--surface, #ffffff); border: 2px solid var(--line, rgba(26,26,26,0.08)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-weight: 700; color: var(--orange); font-size: 1.2rem; box-shadow: 0 4px 10px rgba(0,0,0,0.03);">2</div>
            <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--ink);">General AI Context</h4>
            <p style="font-size: 0.95rem; color: var(--ink-muted); margin-bottom: 1rem; line-height: 1.5;">Base context defines the AI’s role and the structure of the learning game.</p>
            <div class="zoomable-container" style="width: 100%; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border-radius: 8px; border: 1px solid var(--line, rgba(26,26,26,0.08)); overflow: hidden;">
              <img src="/assets/projects/plane-it-right/promptAi1.jpeg" alt="General AI Context" class="zoomable-image" tabindex="0" aria-label="Zoom image" style="width: 100%; display: block;" />
              <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
            </div>
          </div>

          <!-- Step 3: Prompt -->
          <div class="ai-process-step" style="position: relative; z-index: 1; padding-left: 4rem;">
            <div style="position: absolute; left: 0; top: 0; width: 3rem; height: 3rem; background: var(--surface, #ffffff); border: 2px solid var(--line, rgba(26,26,26,0.08)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-weight: 700; color: var(--orange); font-size: 1.2rem; box-shadow: 0 4px 10px rgba(0,0,0,0.03);">3</div>
            <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--ink);">Dynamic Generation Prompt</h4>
            <p style="font-size: 0.95rem; color: var(--ink-muted); margin-bottom: 1rem; line-height: 1.5;">The generation prompt uses the game title, selected category, and existing items to produce a relevant, non-duplicate suggestion.</p>
            <div class="zoomable-container" style="width: 100%; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border-radius: 8px; border: 1px solid var(--line, rgba(26,26,26,0.08)); overflow: hidden;">
              <img src="/assets/projects/plane-it-right/promptAi2.jpeg" alt="Dynamic Generation Prompt" class="zoomable-image" tabindex="0" aria-label="Zoom image" style="width: 100%; display: block;" />
              <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TECHNICAL DEVELOPMENT: ALTERNATING LARGE BLOCKS -->
    <div class="reveal" style="margin-top: 3rem; margin-bottom: 2rem;">
      <p class="eyebrow">Technical Development</p>
    </div>
    
    <div class="technical-alternating-grid">
      <!-- Block A -->
      <div class="split-layout tech-block reveal">
        <div class="split-text-block">
          <h4 style="font-size: 1.5rem; margin-bottom: 1rem;">A. Authoring System Backend</h4>
          <p style="font-size: 1.1rem; line-height: 1.65; color: var(--ink-muted);">C# server-side logic and API handling for creating, editing, publishing, duplicating, and managing learning games in the authoring environment. This includes communicating with an API to generate and process the AI-suggested text items.</p>
        </div>
        <div class="split-visual-frame large-media-frame">
          <div class="zoomable-container" style="width: 100%;">
            <img src="/assets/projects/plane-it-right/plane-it-right-editor-backend.png" alt="Authoring System Backend" class="zoomable-image" tabindex="0" aria-label="Zoom image" style="width: 100%; border-radius: 12px; display: block;" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>

      <!-- Block B -->
      <div class="split-layout tech-block reverse reveal">
        <div class="split-text-block">
          <h4 style="font-size: 1.5rem; margin-bottom: 1rem;">B. Unity Development</h4>
          <p style="font-size: 1.1rem; line-height: 1.65; color: var(--ink-muted);">Building the player-facing game environment in Unity, including the scene, visual structure, interactive elements, and gameplay flow.</p>
        </div>
        <div class="split-visual-frame large-media-frame">
          <div class="zoomable-container" style="width: 100%;">
            <img src="/assets/projects/plane-it-right/plane-it-right-unity-development.png" alt="Unity Development" class="zoomable-image" tabindex="0" aria-label="Zoom image" style="width: 100%; border-radius: 12px; display: block;" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>

      <!-- Block C -->
      <div class="split-layout tech-block reveal">
        <div class="split-text-block">
          <h4 style="font-size: 1.5rem; margin-bottom: 1rem;">C. Player Game Logic</h4>
          <p style="font-size: 1.1rem; line-height: 1.65; color: var(--ink-muted);">Programming the gameplay logic in C#, including content handling, sorting behavior, feedback, and dynamic interaction.</p>
        </div>
        <div class="split-visual-frame large-media-frame">
          <div class="zoomable-container" style="width: 100%;">
            <img src="/assets/projects/plane-it-right/plane-it-right-player-game-logic.png" alt="Player Game Logic" class="zoomable-image" tabindex="0" aria-label="Zoom image" style="width: 100%; border-radius: 12px; display: block;" />
            <button class="zoom-button" aria-label="Zoom image" tabindex="-1">🔍</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE LEARNING EXPERIENCE (VIDEO) -->
  <section class="wrap section" id="experience" aria-labelledby="exp-heading" style="padding-bottom: 6rem;">
    <div class="split-layout video-split" style="align-items: center;">
      <div class="split-text-block reveal">
        <p class="eyebrow">06 / End-to-End Walkthrough</p>
        <h2 id="exp-heading">From Authoring to Play<span>.</span></h2>
        <p style="font-size: 1.15rem; line-height: 1.65; color: var(--ink-muted);">
          The final learning experience begins in the authoring system, where educators define content and publish a game. From there, learners enter the game code, access the correct content, and play through the sorting experience while receiving feedback. This end-to-end flow demonstrates how instructional design, AI-assisted authoring, and technical development come together in one product.
        </p>
      </div>

      <!-- LARGE VIDEO SHOWCASE -->
      <div class="split-visual-frame reveal" data-delay="1">
        <div class="css-computer-mockup">
          <div class="mockup-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <video style="width: 100%; display: block;" controls preload="metadata" playsinline>
            <source src="/assets/projects/plane-it-right/plane-it-right-full-flow.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
    </div>

    <!-- Navigation to Next Case -->
    {nextCase && (
      <div style="text-align: center; margin-top: 5rem;" class="reveal">
        <a class="button button-dark" href={nextCase.href}>
          {nextCase.label} <span aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </section>

  <!-- LIGHTBOX MODAL -->
