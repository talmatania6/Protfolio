---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('cases', 'learning-game-generator');
if (!entry) throw new Error('Missing src/content/cases/learning-game-generator.md');
const { meta, breadcrumb, tags, hero, subnav, glance, impact, nextCase } = entry.data;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="article"
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <!-- CASE HERO HEADER (LEFT-ALIGNED) -->
  <header class="wrap" id="overview" aria-labelledby="case-title" style="padding-top: 2.5rem; text-align: left;">
    <!-- Top Left Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">← Portfolio</a>
      <span class="separator">/</span>
      <span>{breadcrumb}</span>
    </nav>

    <div class="reveal">
      <div class="card-tags" style="margin-bottom: 1rem;">
        {
          tags.map((tag) => (
            <span class={tag.highlight ? 'tag-pill-sm highlight' : 'tag-pill-sm'}>{tag.label}</span>
          ))
        }
      </div>

      <h1 class="hero-name" id="case-title" style="font-size: clamp(2.8rem, 5.5vw, 4.5rem); margin-bottom: 0.75rem;">
        {hero.title}<span>.</span>
      </h1>

      <p class="hero-role-title" style="font-size: clamp(1.25rem, 2vw, 1.65rem); color: var(--ink-muted); font-weight: 600; margin-bottom: 1.5rem;">
        {hero.tagline}
      </p>

      <p class="hero-value-prop" style="margin-inline: 0; max-width: 820px; font-size: 1.25rem;" set:html={hero.valueProp} />

      <!-- LARGE DEDICATED SHOWCASE MEDIA PLACEHOLDER -->
      <div class="showcase-media-frame">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 1rem; margin-bottom: 1.5rem;">
          <span style="font-family: var(--display); font-size: 0.85rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--orange);">
            ✈️ Showcase Video &amp; Interactive Sandbox
          </span>
          <span class="pill-badge dark">WebGL + AI Engine</span>
        </div>

        <!-- Video / High-Resolution Image Frame Placeholder -->
        <div style="background: rgba(0,0,0,0.4); border-radius: var(--radius-md); border: 2px dashed rgba(255,255,255,0.15); min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; position: relative;">
          <div style="font-size: 3.5rem; margin-bottom: 1rem;">▶️</div>
          <h3 style="color: #ffffff; font-size: 1.4rem; margin: 0 0 0.5rem;">Interactive Gameplay &amp; AI Generator Showcase</h3>
          <p style="color: rgba(255,255,255,0.7); max-width: 520px; font-size: 0.95rem; margin: 0;">
            [ Dedicated Placeholder for Embedded Gameplay Video / High-Resolution Showcase Visuals ]
          </p>
          <div style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; justify-content: center;">
            <span class="pill-badge dark">Luggage Conveyor Mechanics</span>
            <span class="pill-badge dark">AI Taxonomy Authoring</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- IN-PAGE STICKY SUBNAV WITH ACTIVE HIGHLIGHT -->
  <nav class="case-subnav" aria-label="Case study navigation">
    <div class="wrap">
      <ul class="case-subnav-list">
        {
          subnav.map((item, index) => (
            <li>
              <a href={item.href} class={index === 0 ? 'is-active' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- 01 / "AT A GLANCE" SECTION (3 DISTINCT CARDS) -->
  <section class="wrap at-a-glance-section" aria-labelledby="glance-heading">
    <h2 id="glance-heading" class="sr-only">Project At A Glance</h2>
    <div class="at-a-glance-grid">
      {
        glance.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon" aria-hidden="true">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- 02 / CONTENT BLOCKS: SCANNABLE ALTERNATING LAYOUTS -->

  <!-- BLOCK 1: THE CHALLENGE -->
  <section class="wrap section" id="challenge" aria-labelledby="challenge-heading" style="padding-top: 2rem;">
    <div class="split-alternating">
      <div class="split-text-block reveal">
        <p class="eyebrow">01 / The Pedagogical Dilemma</p>
        <h2 id="challenge-heading">Binary Recognition vs. True Fluency<span>.</span></h2>
        <p>
          Traditional e-learning relies on static multiple-choice questions. While easy to grade, they test passive <em>recognition</em> through elimination rather than active <em>retrieval automaticity</em>.
        </p>
        <p>
          In high-stakes work environments, learners must classify concepts rapidly and accurately under temporal pressure. Furthermore, traditional gamified quizzes suffer from two fatal pedagogical flaws:
        </p>
        <ul>
          <li><strong>The Punitive "Game Over" Wall:</strong> Ejecting learners after 3 strikes causes frustration rather than reinforcement.</li>
          <li><strong>The "Pause-Screen Cheat":</strong> Freezing game timers allows users to scan external cheat-sheets, defeating genuine retrieval practice.</li>
        </ul>

        <div class="takeaway-box">
          <p><strong>Core Need:</strong> An engaging interaction loop that builds cognitive speed without punitive failure states.</p>
        </div>
      </div>

      <div class="split-visual-frame reveal" data-delay="1">
        <span style="font-size: 0.75rem; font-weight: 800; color: var(--orange); text-transform: uppercase; letter-spacing: 0.06em;">The Cognitive Bottleneck</span>
        <h4 style="font-size: 1.25rem; margin: 0.5rem 0 1rem;">Passive Quiz vs. Active Fluency</h4>

        <div style="display: grid; gap: 0.85rem;">
          <div style="background: var(--paper-soft); padding: 1rem; border-radius: 8px; border-left: 3px solid #e05252;">
            <strong style="display: block; font-size: 0.9rem; color: #e05252; margin-bottom: 0.2rem;">❌ Traditional Multiple Choice</strong>
            <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Infinite time to guess; tests passive elimination rather than real-time recall.</p>
          </div>

          <div style="background: var(--paper-soft); padding: 1rem; border-radius: 8px; border-left: 3px solid #38a169;">
            <strong style="display: block; font-size: 0.9rem; color: #38a169; margin-bottom: 0.2rem;">✓ Airport Conveyor Sorting</strong>
            <p style="margin: 0; font-size: 0.88rem; color: var(--ink-muted);">Mild temporal pressure stimulates rapid mental schema activation and automaticity.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK 2: THE INSTRUCTIONAL CRACKING -->
  <section class="wrap section" id="cracking" aria-labelledby="cracking-heading">
    <div class="split-alternating reverse">
      <div class="split-text-block reveal">
        <p class="eyebrow">02 / Pedagogical Logic</p>
        <h2 id="cracking-heading">The Instructional Cracking<span>.</span></h2>
        <p>
          I framed the learning experience around an intuitive real-world metaphor: <strong>The Airport Baggage Claim</strong>.
        </p>
        <p>
          Luggage rolls down the conveyor belt tagged with conceptual items. The learner acts as the flight controller, directing each bag to the correct destination plane before it passes.
        </p>
        <ul>
          <li><strong>Non-Punitive Recovery Queue:</strong> When a learner misclassifies a bag, the system does not penalize them with a game over. Instead, the item is dynamically re-queued later until correctly sorted.</li>
          <li><strong>Cognitive Occlusion on Pause:</strong> Pausing the game instantly blurs all active luggage tags to prevent cheat-scanning and safeguard retrieval integrity.</li>
          <li><strong>Feedback Pacing:</strong> Visual cues (green beacon / red deflection) provide instant micro-feedback without interrupting the learner's flow state.</li>
        </ul>

        <div class="takeaway-box">
          <p><strong>Pedagogical Win:</strong> 100% module completion with proven retention through iterative practice.</p>
        </div>
      </div>

      <div class="split-visual-frame reveal" data-delay="1">
        <span style="font-size: 0.75rem; font-weight: 800; color: var(--orange); text-transform: uppercase; letter-spacing: 0.06em;">Interaction Architecture</span>
        <h4 style="font-size: 1.25rem; margin: 0.5rem 0 1rem;">Airport Conveyor Mechanics</h4>

        <div style="display: grid; gap: 0.85rem;">
          <div style="display: flex; gap: 0.75rem; align-items: flex-start; background: var(--paper-soft); padding: 0.85rem; border-radius: 8px;">
            <span style="font-size: 1.25rem;">🧳</span>
            <div>
              <strong style="font-size: 0.92rem; display: block;">Luggage Conveyor</strong>
              <p style="margin: 0; font-size: 0.85rem; color: var(--ink-muted);">Paced delivery creating productive, motivating time pressure.</p>
            </div>
          </div>

          <div style="display: flex; gap: 0.75rem; align-items: flex-start; background: var(--paper-soft); padding: 0.85rem; border-radius: 8px;">
            <span style="font-size: 1.25rem;">🔄</span>
            <div>
              <strong style="font-size: 0.92rem; display: block;">Dynamic Mistake Queue</strong>
              <p style="margin: 0; font-size: 0.85rem; color: var(--ink-muted);">Missed concepts return seamlessly until mastery is demonstrated.</p>
            </div>
          </div>

          <div style="display: flex; gap: 0.75rem; align-items: flex-start; background: var(--paper-soft); padding: 0.85rem; border-radius: 8px;">
            <span style="font-size: 1.25rem;">🔒</span>
            <div>
              <strong style="font-size: 0.92rem; display: block;">Anti-Cheat Pause Occlusion</strong>
              <p style="margin: 0; font-size: 0.85rem; color: var(--ink-muted);">Blurs active tags upon pause to safeguard retrieval integrity.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK 3: AI INTEGRATION & GENERATOR -->
  <section class="wrap section" id="ai-solution" aria-labelledby="ai-heading">
    <div class="split-alternating">
      <div class="split-text-block reveal">
        <p class="eyebrow">03 / Dual-Sided Scaling</p>
        <h2 id="ai-heading">AI as an Authoring Multiplier<span>.</span></h2>
        <p>
          An educational game is only as good as its content variety. Creating high-quality taxonomic categories, plausible distractors, and balanced datasets is notoriously tedious for educators.
        </p>
        <p>
          I engineered an in-editor <strong>AI Content Generator</strong>. Educators simply enter their topic (e.g. <em>"Grammar: Verb Tenses"</em> or <em>"Medical: Cardiac Medications"</em>) and the system generates:
        </p>
        <ul>
          <li><strong>Curriculum-Aligned Categorization:</strong> Clean taxonomies matching academic objectives.</li>
          <li><strong>High-Quality Distractors:</strong> Plausible, balanced terms that challenge learner misconceptions.</li>
          <li><strong>Strict Defensive JSON Schemas:</strong> Zero-shot validation preventing hallucinations and ensuring seamless game loading.</li>
        </ul>

        <div class="takeaway-box">
          <p><strong>Efficiency Gain:</strong> Reduced authoring time from 90 minutes to <strong>under 30 seconds</strong> per module.</p>
        </div>
      </div>

      <div class="split-visual-frame reveal" data-delay="1" style="background: var(--ink); color: #ffffff;">
        <span style="font-size: 0.72rem; font-weight: 800; color: #ffaa40; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">Defensive AI Pipeline</span>
        <h4 style="color: #ffffff; font-size: 1.2rem; margin: 0 0 1rem;">Teacher Prompt → Unity Schema</h4>

        <!-- Braces are escaped as {'{'} / {'}'} so Astro doesn't read them as expressions. -->
        <div style="font-family: monospace; font-size: 0.82rem; background: rgba(255,255,255,0.06); padding: 1rem; border-radius: 8px; color: #a5f3fc; line-height: 1.55; overflow-x: auto;">
          {'{'}<br />
          &nbsp;&nbsp;"topic": "Cellular Biology",<br />
          &nbsp;&nbsp;"categories": ["Organelles", "Membrane Transport"],<br />
          &nbsp;&nbsp;"items": [<br />
          &nbsp;&nbsp;&nbsp;&nbsp;{'{'}"tag": "Mitochondria", "target": "Organelles"{'}'},<br />
          &nbsp;&nbsp;&nbsp;&nbsp;{'{'}"tag": "Osmosis", "target": "Membrane Transport"{'}'}<br />
          &nbsp;&nbsp;]<br />
          {'}'}
        </div>
        <p style="font-size: 0.82rem; color: rgba(255,255,255,0.6); margin: 0.85rem 0 0;">
          ✓ Validated against Unity runtime data models before loading.
        </p>
      </div>
    </div>
  </section>

  <!-- BLOCK 4: IMPACT & TAKEAWAYS -->
  <section class="wrap section" id="impact" aria-labelledby="impact-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">{impact.eyebrow}</p>
      <h2 id="impact-heading"><Fragment set:html={impact.heading} /><span>.</span></h2>
      <p class="hook" set:html={impact.hook} />
    </div>

    <div class="at-a-glance-grid">
      {
        impact.cards.map((card, index) => (
          <article class="at-a-glance-card reveal" data-delay={index + 1}>
            <span class="glance-icon" aria-hidden="true">{card.icon}</span>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>

    <!-- Navigation to Next Case -->
    <div style="text-align: left; margin-top: 3.5rem;" class="reveal">
      <a class="button button-dark" href={nextCase.href}>
        {nextCase.label} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
