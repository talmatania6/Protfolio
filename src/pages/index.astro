---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing src/content/global/home.md');
const { meta, hero, projects, philosophy, process, about, toolkit } = home.data;

const site = await getEntry('site', 'site');
if (!site) throw new Error('Missing src/content/global/site.md');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogType="website"
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
>
  <!-- HERO SECTION (100VH FULL VIEWPORT HEIGHT, LEFT-ALIGNED) -->
  <section class="hero wrap" aria-labelledby="hero-name">
    <div class="hero-inner">
      <!-- Subtle Floating Abstract Background Shapes -->
      <span class="floating-shape shape-1" aria-hidden="true">✦</span>
      <span class="floating-shape shape-2" aria-hidden="true">✧</span>
      <span class="floating-shape shape-3" aria-hidden="true">+</span>
      <span class="floating-shape shape-4" aria-hidden="true">✢</span>

      <div class="reveal" style="display: flex; flex-direction: column; padding-bottom: 2rem;">
        <div class="hero-kicker-badge" style="margin-bottom: 1.5rem;">
          <span class="pill-badge" style="font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; padding: 0.5rem 1rem; background: var(--surface); border: 1px solid var(--border); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">OPEN TO INSTRUCTIONAL DESIGN & LEARNING TECH OPPORTUNITIES</span>
        </div>

        <h1 id="hero-name" class="hero-name" style="margin-bottom: 0.15rem; line-height: 1.1;">
          <span class="marker-underline">Tal Matania</span>
        </h1>
        
        <h2 class="hero-role-title" style="margin-bottom: 1rem; line-height: 1.35; color: var(--ink);">
          I’m an <span style="color: var(--orange);">Instructional Designer</span><br/>
          & <span style="color: var(--orange);">Learning Technologies</span> student.
        </h2>

        <div class="hero-value-prop">
          <p style="font-size: 1.25rem; line-height: 1.6; max-width: 700px; margin: 0; color: var(--ink-muted);">
            I design learning experiences that connect instructional thinking with visual design and hands-on development.
          </p>
        </div>

        <div class="hero-actions" style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem;">
          <a class="button button-primary" href="#projects">
            See My Work <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 / FEATURED PROJECTS (2-COLUMN RECTANGULAR GRID) -->
  <section class="section wrap" id="projects" aria-labelledby="projects-heading">
    <div class="section-heading reveal">
      <p class="eyebrow">{projects.eyebrow}</p>
      <h2 id="projects-heading"><Fragment set:html={projects.heading} /><span>.</span></h2>
      <p class="hook" set:html={projects.hook} />
    </div>

    <div class="projects-grid-2col">
      {
        projects.items.map((project) => (
          <article class="project-card-rectangular reveal" data-delay={project.delay}>
            <a class="card-preview-frame" href={project.href} aria-label={project.ariaLabel} style={`position: relative; overflow: hidden; background: linear-gradient(135deg, ${project.gradient[0]} 0%, ${project.gradient[1]} 100%);`}>
              {project.previewImage ? (
                <img src={project.previewImage} alt="" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
              ) : (
                <div
                  style="position: relative; z-index: 1; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 1.75rem; color: #fff;"
                >
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="pill-badge dark">{project.badge}</span>
                    <span style="font-size: 1.4rem;">{project.cornerEmoji}</span>
                  </div>
                  <div>
                    <div style="font-size: 2.5rem; margin-bottom: 0.35rem;">{project.emojiRow}</div>
                    <div style="font-family: var(--display); font-weight: 800; font-size: 1.35rem; color: #ffffff;">
                      {project.previewTitle}
                    </div>
                    <p
                      style="font-size: 0.95rem; color: rgba(255,255,255,0.7); margin: 0.25rem 0 0;"
                      set:html={project.previewBlurb}
                    />
                  </div>
                  <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: rgba(255,255,255,0.6); border-top: 1px solid rgba(255,255,255,0.1); padding-top: 0.65rem;">
                    <span>{project.footerLeft}</span>
                    <span>{project.footerRight}</span>
                  </div>
                </div>
              )}
            </a>
            <div class="card-content-area">
              <div>
                <div class="card-tags">
                  {
                    project.tags.map((tag) => (
                      <span class={tag.highlight ? 'tag-pill-sm highlight' : 'tag-pill-sm'}>
                        {tag.label}
                      </span>
                    ))
                  }
                </div>
                <h3><a href={project.href} set:html={project.title} /></h3>
                <p set:html={project.description} />
              </div>
              <a class="card-cta-link" href={project.href}>
                View Case Study <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 04 / ABOUT ME & TOOLKIT -->
  <section class="section wrap" id="about" aria-labelledby="about-title">
    <div class="split-layout" style="align-items: flex-start; gap: 4rem;">
      <!-- Left: Portrait Frame -->
      <div class="split-visual-frame reveal" style="background: transparent; border: none; padding: 0;">
        <div style="position: sticky; top: 100px;">
          <img 
            src={about.image} 
            alt="Tal Matania" 
            style="width: 100%; border-radius: var(--radius-md, 14px); object-fit: cover; box-shadow: 0 10px 40px rgba(0,0,0,0.05);"
          />
          <div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: flex-start; overflow: visible;">
            {site.data.linkedin && (
              <a href={site.data.linkedin} target="_blank" rel="noopener noreferrer" style="display: inline-block; white-space: nowrap; padding-inline: 0.25rem; color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.95rem; border-bottom: 2px solid transparent; transition: color 0.2s;">
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
            )}
            {site.data.behance && (
              <a href={site.data.behance} target="_blank" rel="noopener noreferrer" style="display: inline-block; white-space: nowrap; padding-inline: 0.25rem; color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.95rem; border-bottom: 2px solid transparent; transition: color 0.2s;">
                Behance <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </div>
      
      <!-- Right: Story & Toolkit -->
      <div class="split-text-block reveal" data-delay="1" style="max-width: 650px;">
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 id="about-title"><Fragment set:html={about.heading} /><span>.</span></h2>
        
        <div style="margin-bottom: 2rem;">
          <h3 style="font-family: 'Caveat', cursive; font-size: 2.2rem; color: var(--orange); margin-bottom: 1.5rem; font-weight: 500;">
            {about.greeting}
          </h3>
          <p style="font-size: 1.1rem; line-height: 1.7; color: var(--ink-muted); margin-bottom: 0;" set:html={about.body} />
        </div>
          
        <!-- Toolkit -->
        <div style="margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid var(--line, rgba(26,26,26,0.1));">
          <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 2rem; letter-spacing: -0.02em;">{toolkit.heading}</h3>
          
          <div style="display: flex; flex-direction: column; gap: 0.85rem;">
            {toolkit.groups.map((group: any) => (
              <div>
                <p style="font-size: 0.85rem; font-weight: 800; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.65rem; display: flex; align-items: center; gap: 0.5rem;">
                  <span>{group.icon}</span> {group.title}
                </p>
                <ul class="tool-pill-list">
                  {group.tools.map((tool: any) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
          
        <!-- Off Screen Note -->
        <div style="margin-top: 1.5rem; padding: 1.25rem 1.5rem; background: rgba(246, 241, 235, 0.6); border-radius: 12px; border: 1px solid var(--line, rgba(26,26,26,0.05)); display: flex; align-items: flex-start; gap: 0.75rem;">
          <span style="font-size: 1.2rem; margin-top: 0.1rem;" aria-hidden="true">🪴</span>
          <p style="font-size: 0.95rem; line-height: 1.6; color: var(--ink-muted); margin: 0;">
            <strong style="font-family: 'Caveat', cursive; font-size: 1.45rem; color: var(--orange); font-weight: 600; margin-right: 0.25rem;">Off screen:</strong>
            {about.offScreen}
          </p>
        </div>
      </div>
    </div>
  </section>



  <style>
    /* SPLIT LAYOUT FOR ABOUT ME */
    .split-layout {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
    .split-text-block {
      flex: 1;
    }
    .split-visual-frame {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }
    @media (min-width: 900px) {
      .split-layout {
        flex-direction: row;
        gap: 5rem;
        align-items: flex-start;
      }
      .split-visual-frame {
        flex: 0 0 35%; /* Portrait takes ~1/3 of the screen width */
      }
      .split-text-block {
        flex: 1;       /* Text takes the remaining space */
      }
    }
  </style>
</BaseLayout>
